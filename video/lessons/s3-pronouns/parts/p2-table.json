{"segments": [
 {"id": "c03-title-01", "scene": "c03-title", "lang": "en", "text": "Chapter three. The twelve separate pronouns.", "pause": 0.6, "cues": ["title"]},
 {"id": "c03-table-01", "scene": "c03-table", "lang": "en", "text": "Learn this table by heart.", "pause": 0.25, "cues": ["p:1"]},
 {"id": "c03-table-02", "scene": "c03-table", "lang": "en", "text": "Read it aloud, top to bottom, every day this week.", "pause": 0.4, "cues": ["head"]},
 {"id": "c03-table-03", "scene": "c03-table", "lang": "en", "text": "Each row gives the person, the number and the gender. Then the Arabic, and its meaning.", "pause": 0.5, "cues": []},
 {"id": "c03-table-04", "scene": "c03-table", "lang": "en", "text": "First person, the speaker alone. A man or a woman. I.", "pause": 0.3, "cues": ["row:1"]},
 {"id": "c03-table-05", "scene": "c03-table", "lang": "ar", "text": "أَنَا", "pause": 0.5, "cues": []},
 {"id": "c03-table-06", "scene": "c03-table", "lang": "en", "text": "The speaker with others. Two or more, men or women. We.", "pause": 0.3, "cues": ["row:2"]},
 {"id": "c03-table-07", "scene": "c03-table", "lang": "ar", "text": "نَحْنُ", "pause": 0.5, "cues": []},
 {"id": "c03-table-08", "scene": "c03-table", "lang": "en", "text": "Second person, the listener. One man. You.", "pause": 0.3, "cues": ["row:3"]},
 {"id": "c03-table-09", "scene": "c03-table", "lang": "ar", "text": "أَنْتَ", "pause": 0.5, "cues": []},
 {"id": "c03-table-10", "scene": "c03-table", "lang": "en", "text": "Second person, one woman. You.", "pause": 0.3, "cues": ["row:4"]},
 {"id": "c03-table-11", "scene": "c03-table", "lang": "ar", "text": "أَنْتِ", "pause": 0.5, "cues": []},
 {"id": "c03-table-12", "scene": "c03-table", "lang": "en", "text": "Second person, two people, men or women. You two.", "pause": 0.3, "cues": ["row:5"]},
 {"id": "c03-table-13", "scene": "c03-table", "lang": "ar", "text": "أَنْتُمَا", "pause": 0.5, "cues": []},
 {"id": "c03-table-14", "scene": "c03-table", "lang": "en", "text": "Second person, three or more. Men, or men and women. You.", "pause": 0.3, "cues": ["row:6"]},
 {"id": "c03-table-15", "scene": "c03-table", "lang": "ar", "text": "أَنْتُمْ", "pause": 0.5, "cues": []},
 {"id": "c03-table-16", "scene": "c03-table", "lang": "en", "text": "Second person, three or more women. You.", "pause": 0.3, "cues": ["row:7"]},
 {"id": "c03-table-17", "scene": "c03-table", "lang": "ar", "text": "أَنْتُنَّ", "pause": 0.5, "cues": []},
 {"id": "c03-table-18", "scene": "c03-table", "lang": "en", "text": "Third person, the absent one. One, masculine. He, or it.", "pause": 0.3, "cues": ["row:8"]},
 {"id": "c03-table-19", "scene": "c03-table", "lang": "ar", "text": "هُوَ", "pause": 0.5, "cues": []},
 {"id": "c03-table-20", "scene": "c03-table", "lang": "en", "text": "Third person, one, feminine. She, or it.", "pause": 0.3, "cues": ["row:9"]},
 {"id": "c03-table-21", "scene": "c03-table", "lang": "ar", "text": "هِيَ", "pause": 0.5, "cues": []},
 {"id": "c03-table-22", "scene": "c03-table", "lang": "en", "text": "Third person, two people, men or women. They, the two of them.", "pause": 0.3, "cues": ["row:10"]},
 {"id": "c03-table-23", "scene": "c03-table", "lang": "ar", "text": "هُمَا", "pause": 0.5, "cues": []},
 {"id": "c03-table-24", "scene": "c03-table", "lang": "en", "text": "Third person, three or more. Men, or men and women. They.", "pause": 0.3, "cues": ["row:11"]},
 {"id": "c03-table-25", "scene": "c03-table", "lang": "ar", "text": "هُمْ", "pause": 0.5, "cues": []},
 {"id": "c03-table-26", "scene": "c03-table", "lang": "en", "text": "Third person, three or more women. They.", "pause": 0.3, "cues": ["row:12"]},
 {"id": "c03-table-27", "scene": "c03-table", "lang": "ar", "text": "هُنَّ", "pause": 0.8, "cues": []},
 {"id": "c03-table-28", "scene": "c03-table", "lang": "en", "text": "That is the whole table. Twelve words.", "pause": 0.8, "cues": []},
 {"id": "c03-tip1-01", "scene": "c03-tip1", "lang": "en", "text": "A tip. Watch the small vowels.", "pause": 0.4, "cues": ["show"]},
 {"id": "c03-tip1-02", "scene": "c03-tip1", "lang": "en", "text": "For one man, fatha on the last letter.", "pause": 0.3, "cues": []},
 {"id": "c03-tip1-03", "scene": "c03-tip1", "lang": "ar", "text": "أَنْتَ", "pause": 0.5, "cues": ["hl:أَنْتَ"]},
 {"id": "c03-tip1-04", "scene": "c03-tip1", "lang": "en", "text": "For one woman, kasra on the last letter.", "pause": 0.3, "cues": []},
 {"id": "c03-tip1-05", "scene": "c03-tip1", "lang": "ar", "text": "أَنْتِ", "pause": 0.5, "cues": ["hl:أَنْتِ"]},
 {"id": "c03-tip1-06", "scene": "c03-tip1", "lang": "en", "text": "For a group of men, the last letter is an m, with sukūn.", "pause": 0.3, "cues": []},
 {"id": "c03-tip1-07", "scene": "c03-tip1", "lang": "ar", "text": "هُمْ", "pause": 0.5, "cues": ["hl:هُمْ"]},
 {"id": "c03-tip1-08", "scene": "c03-tip1", "lang": "en", "text": "For a group of women, the last letter is an n, with a shadda.", "pause": 0.3, "cues": []},
 {"id": "c03-tip1-09", "scene": "c03-tip1", "lang": "ar", "text": "هُنَّ", "pause": 0.5, "cues": ["hl:هُنَّ"]},
 {"id": "c03-tip1-10", "scene": "c03-tip1", "lang": "en", "text": "A small mark, or one letter, changes the meaning. So read every letter and every vowel.", "pause": 0.8, "cues": []},
 {"id": "c03-tip2-01", "scene": "c03-tip2", "lang": "en", "text": "A side note. Each pronoun is built on one fixed mark.", "pause": 0.4, "cues": ["show"]},
 {"id": "c03-tip2-02", "scene": "c03-tip2", "lang": "ar", "text": "هُوَ", "pause": 0.4, "cues": ["hl:هُوَ"]},
 {"id": "c03-tip2-03", "scene": "c03-tip2", "lang": "en", "text": "Built on fatha.", "pause": 0.3, "cues": []},
 {"id": "c03-tip2-04", "scene": "c03-tip2", "lang": "ar", "text": "نَحْنُ", "pause": 0.4, "cues": ["hl:نَحْنُ"]},
 {"id": "c03-tip2-05", "scene": "c03-tip2", "lang": "en", "text": "On damma.", "pause": 0.3, "cues": []},
 {"id": "c03-tip2-06", "scene": "c03-tip2", "lang": "ar", "text": "هُمْ", "pause": 0.4, "cues": ["hl:هُمْ"]},
 {"id": "c03-tip2-07", "scene": "c03-tip2", "lang": "en", "text": "On sukūn.", "pause": 0.4, "cues": []},
 {"id": "c03-tip2-08", "scene": "c03-tip2", "lang": "en", "text": "You do not need to learn these.", "pause": 0.3, "cues": ["hl:You do not need to learn these."]},
 {"id": "c03-tip2-09", "scene": "c03-tip2", "lang": "en", "text": "Just remember the word never changes.", "pause": 0.8, "cues": []}
]}
