{"segments": [
 {"id": "hero-01", "scene": "hero", "lang": "en", "text": "Separate pronouns. Twelve words you will see every day.", "pause": 0.5, "cues": ["title"]},
 {"id": "hero-02", "scene": "hero", "lang": "en", "text": "Stage three is about fixed words.", "pause": 0.3, "cues": ["sub"]},
 {"id": "hero-03", "scene": "hero", "lang": "en", "text": "We start with the pronouns. I, he, she, we, and their friends.", "pause": 0.8, "cues": []},
 {"id": "c01-title-01", "scene": "c01-title", "lang": "en", "text": "Chapter one. Why we learn fixed words now.", "pause": 0.6, "cues": ["title"]},
 {"id": "c01-why-01", "scene": "c01-why", "lang": "en", "text": "Fixed words are in almost every sentence.", "pause": 0.3, "cues": ["p:1"]},
 {"id": "c01-why-02", "scene": "c01-why", "lang": "en", "text": "Pronouns are fixed words. So are pointing words, like the word for this.", "pause": 0.4, "cues": []},
 {"id": "c01-why-03", "scene": "c01-why", "lang": "ar", "text": "هَذَا", "pause": 0.5, "cues": ["hl:هَذَا"]},
 {"id": "c01-why-04", "scene": "c01-why", "lang": "en", "text": "And so are question words. They come again and again.", "pause": 0.5, "cues": []},
 {"id": "c01-why-05", "scene": "c01-why", "lang": "en", "text": "Their ending never changes.", "pause": 0.3, "cues": ["p:2"]},
 {"id": "c01-why-06", "scene": "c01-why", "lang": "en", "text": "So you learn each one once, as a word in a table. Then you know it for good.", "pause": 0.5, "cues": []},
 {"id": "c01-why-07", "scene": "c01-why", "lang": "en", "text": "When you know them, every later example is easier.", "pause": 0.3, "cues": ["p:3"]},
 {"id": "c01-why-08", "scene": "c01-why", "lang": "en", "text": "You see the fixed words at once. Then you look only at the flexible ones.", "pause": 0.5, "cues": []},
 {"id": "c01-why-09", "scene": "c01-why", "lang": "en", "text": "Here are four pronouns.", "pause": 0.4, "cues": []},
 {"id": "c01-why-10", "scene": "c01-why", "lang": "en", "text": "I.", "pause": 0.3, "cues": ["word:1"]},
 {"id": "c01-why-11", "scene": "c01-why", "lang": "ar", "text": "أَنَا", "pause": 0.5, "cues": []},
 {"id": "c01-why-12", "scene": "c01-why", "lang": "en", "text": "He, or it.", "pause": 0.3, "cues": ["word:2"]},
 {"id": "c01-why-13", "scene": "c01-why", "lang": "ar", "text": "هُوَ", "pause": 0.5, "cues": []},
 {"id": "c01-why-14", "scene": "c01-why", "lang": "en", "text": "She, or it.", "pause": 0.3, "cues": ["word:3"]},
 {"id": "c01-why-15", "scene": "c01-why", "lang": "ar", "text": "هِيَ", "pause": 0.5, "cues": []},
 {"id": "c01-why-16", "scene": "c01-why", "lang": "en", "text": "We.", "pause": 0.3, "cues": ["word:4"]},
 {"id": "c01-why-17", "scene": "c01-why", "lang": "ar", "text": "نَحْنُ", "pause": 0.8, "cues": []},
 {"id": "c02-title-01", "scene": "c02-title", "lang": "en", "text": "Chapter two. Fixed and flexible. A quick recap.", "pause": 0.6, "cues": ["title"]},
 {"id": "c02-cols-01", "scene": "c02-cols", "lang": "en", "text": "Every word is either fixed or flexible.", "pause": 0.4, "cues": []},
 {"id": "c02-cols-02", "scene": "c02-cols", "lang": "en", "text": "First, a fixed word.", "pause": 0.3, "cues": ["col:1"]},
 {"id": "c02-cols-03", "scene": "c02-cols", "lang": "ar", "text": "مَبْنِيٌّ", "pause": 0.5, "cues": ["hl:مَبْنِيٌّ"]},
 {"id": "c02-cols-04", "scene": "c02-cols", "lang": "en", "text": "Its ending never changes.", "pause": 0.3, "cues": []},
 {"id": "c02-cols-05", "scene": "c02-cols", "lang": "en", "text": "The word for he never changes. It is the same in every sentence.", "pause": 0.4, "cues": []},
 {"id": "c02-cols-06", "scene": "c02-cols", "lang": "ar", "text": "هُوَ", "pause": 0.6, "cues": ["hl:هُوَ", "hl:هُوَ@2"]},
 {"id": "c02-cols-07", "scene": "c02-cols", "lang": "en", "text": "Then, a flexible word.", "pause": 0.3, "cues": ["col:2"]},
 {"id": "c02-cols-08", "scene": "c02-cols", "lang": "ar", "text": "مُعْرَبٌ", "pause": 0.5, "cues": ["hl:مُعْرَبٌ"]},
 {"id": "c02-cols-09", "scene": "c02-cols", "lang": "en", "text": "Its ending changes with the job.", "pause": 0.3, "cues": []},
 {"id": "c02-cols-10", "scene": "c02-cols", "lang": "en", "text": "The house, with damma.", "pause": 0.3, "cues": []},
 {"id": "c02-cols-11", "scene": "c02-cols", "lang": "ar", "text": "البَيْتُ", "pause": 0.5, "cues": ["hl:البَيْتُ"]},
 {"id": "c02-cols-12", "scene": "c02-cols", "lang": "en", "text": "And after a preposition, with kasra.", "pause": 0.3, "cues": []},
 {"id": "c02-cols-13", "scene": "c02-cols", "lang": "ar", "text": "البَيْتِ", "pause": 0.6, "cues": ["hl:البَيْتِ"]},
 {"id": "c02-cols-14", "scene": "c02-cols", "lang": "en", "text": "Pronouns are fixed. Their ending stays the same, whatever the job.", "pause": 0.8, "cues": []}
]}
