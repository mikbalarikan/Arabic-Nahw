{"segments": [
 {"id": "c06-title-01", "scene": "c06-title", "lang": "en", "text": "Chapter six. Sentences with a pronoun.", "pause": 0.6, "cues": ["title"]},
 {"id": "c06-examples-01", "scene": "c06-examples", "lang": "en", "text": "Here the pronoun is the Topic.", "pause": 0.3, "cues": ["p:1"]},
 {"id": "c06-examples-02", "scene": "c06-examples", "lang": "en", "text": "The Information is a noun, or a phrase that tells you where.", "pause": 0.6, "cues": []},
 {"id": "c06-examples-03", "scene": "c06-examples", "lang": "en", "text": "One. I am a student.", "pause": 0.3, "cues": ["ex:1"]},
 {"id": "c06-examples-04", "scene": "c06-examples", "lang": "ar", "text": "أَنَا طَالِبٌ", "pause": 0.5, "cues": []},
 {"id": "c06-examples-05", "scene": "c06-examples", "lang": "en", "text": "The word for I is the Topic, in the place of rafʿ.", "pause": 0.3, "cues": ["note:1", "hl:أَنَا@2"]},
 {"id": "c06-examples-06", "scene": "c06-examples", "lang": "en", "text": "Student is the Information. It is rafʿ, with tanween damma.", "pause": 0.6, "cues": ["hl:طَالِبٌ@2"]},
 {"id": "c06-examples-07", "scene": "c06-examples", "lang": "en", "text": "Two. She is a teacher.", "pause": 0.3, "cues": ["ex:2"]},
 {"id": "c06-examples-08", "scene": "c06-examples", "lang": "ar", "text": "هِيَ مُدَرِّسَةٌ", "pause": 0.5, "cues": []},
 {"id": "c06-examples-09", "scene": "c06-examples", "lang": "en", "text": "The word for she is the Topic, in the place of rafʿ.", "pause": 0.6, "cues": ["note:2", "hl:هِيَ@2"]},
 {"id": "c06-examples-10", "scene": "c06-examples", "lang": "en", "text": "Three. We are in the classroom.", "pause": 0.3, "cues": ["ex:3"]},
 {"id": "c06-examples-11", "scene": "c06-examples", "lang": "ar", "text": "نَحْنُ فِي الفَصْلِ", "pause": 0.5, "cues": []},
 {"id": "c06-examples-12", "scene": "c06-examples", "lang": "en", "text": "The word for we is the Topic, in the place of rafʿ.", "pause": 0.3, "cues": ["note:3", "hl:نَحْنُ@2"]},
 {"id": "c06-examples-13", "scene": "c06-examples", "lang": "en", "text": "The classroom is jarr, with kasra.", "pause": 0.3, "cues": ["hl:الفَصْلِ@2"]},
 {"id": "c06-examples-14", "scene": "c06-examples", "lang": "en", "text": "It comes after a preposition, the word for in.", "pause": 0.6, "cues": ["hl:فِي@2"]},
 {"id": "c06-examples-15", "scene": "c06-examples", "lang": "en", "text": "Four. They are in the mosque.", "pause": 0.3, "cues": ["ex:4"]},
 {"id": "c06-examples-16", "scene": "c06-examples", "lang": "ar", "text": "هُمْ فِي المَسْجِدِ", "pause": 0.5, "cues": []},
 {"id": "c06-examples-17", "scene": "c06-examples", "lang": "en", "text": "The word for they is the Topic, in the place of rafʿ.", "pause": 0.6, "cues": ["note:4", "hl:هُمْ@2"]},
 {"id": "c06-examples-18", "scene": "c06-examples", "lang": "en", "text": "Five. You two are in the house.", "pause": 0.3, "cues": ["ex:5"]},
 {"id": "c06-examples-19", "scene": "c06-examples", "lang": "ar", "text": "أَنْتُمَا فِي البَيْتِ", "pause": 0.5, "cues": []},
 {"id": "c06-examples-20", "scene": "c06-examples", "lang": "en", "text": "The word for you two is the Topic, in the place of rafʿ.", "pause": 0.6, "cues": ["note:5", "hl:أَنْتُمَا@2"]},
 {"id": "c06-examples-21", "scene": "c06-examples", "lang": "en", "text": "Six. Where is the boy? He is in the mosque.", "pause": 0.3, "cues": ["ex:6"]},
 {"id": "c06-examples-22", "scene": "c06-examples", "lang": "ar", "text": "أَيْنَ الوَلَدُ؟ هُوَ فِي المَسْجِدِ", "pause": 0.5, "cues": []},
 {"id": "c06-examples-23", "scene": "c06-examples", "lang": "en", "text": "This one is from the Madinah book, lesson four.", "pause": 0.3, "cues": ["note:6"]},
 {"id": "c06-examples-24", "scene": "c06-examples", "lang": "en", "text": "The word for he is the Topic.", "pause": 0.3, "cues": ["hl:هُوَ@2"]},
 {"id": "c06-examples-25", "scene": "c06-examples", "lang": "en", "text": "It stands for the boy.", "pause": 0.8, "cues": ["hl:الوَلَدُ@2"]},
 {"id": "c06-tip-01", "scene": "c06-tip", "lang": "en", "text": "One last tip. A pronoun can replace a noun.", "pause": 0.4, "cues": ["show"]},
 {"id": "c06-tip-02", "scene": "c06-tip", "lang": "en", "text": "The student is in the classroom.", "pause": 0.3, "cues": []},
 {"id": "c06-tip-03", "scene": "c06-tip", "lang": "ar", "text": "الطَّالِبُ فِي الفَصْلِ", "pause": 0.5, "cues": ["hl:الطَّالِبُ فِي الفَصْلِ"]},
 {"id": "c06-tip-04", "scene": "c06-tip", "lang": "en", "text": "It becomes: He is in the classroom.", "pause": 0.3, "cues": []},
 {"id": "c06-tip-05", "scene": "c06-tip", "lang": "ar", "text": "هُوَ فِي الفَصْلِ", "pause": 0.5, "cues": ["hl:هُوَ فِي الفَصْلِ"]},
 {"id": "c06-tip-06", "scene": "c06-tip", "lang": "en", "text": "Pick the pronoun by number and gender.", "pause": 0.3, "cues": ["hl:by number and gender"]},
 {"id": "c06-tip-07", "scene": "c06-tip", "lang": "en", "text": "One male student, so the word for he.", "pause": 0.8, "cues": []},
 {"id": "summary-01", "scene": "summary", "lang": "en", "text": "In short.", "pause": 0.4, "cues": []},
 {"id": "summary-02", "scene": "summary", "lang": "en", "text": "Fixed words are in every sentence. Learn them once, as a table.", "pause": 0.5, "cues": ["li:1"]},
 {"id": "summary-03", "scene": "summary", "lang": "en", "text": "There are twelve separate pronouns.", "pause": 0.4, "cues": ["li:2"]},
 {"id": "summary-04", "scene": "summary", "lang": "ar", "text": "أَنَا", "pause": 0.3, "cues": ["hl:أَنَا"]},
 {"id": "summary-05", "scene": "summary", "lang": "ar", "text": "نَحْنُ", "pause": 0.3, "cues": ["hl:نَحْنُ"]},
 {"id": "summary-06", "scene": "summary", "lang": "ar", "text": "أَنْتَ", "pause": 0.3, "cues": ["hl:أَنْتَ"]},
 {"id": "summary-07", "scene": "summary", "lang": "ar", "text": "أَنْتِ", "pause": 0.3, "cues": ["hl:أَنْتِ"]},
 {"id": "summary-08", "scene": "summary", "lang": "ar", "text": "أَنْتُمَا", "pause": 0.3, "cues": ["hl:أَنْتُمَا"]},
 {"id": "summary-09", "scene": "summary", "lang": "ar", "text": "أَنْتُمْ", "pause": 0.3, "cues": ["hl:أَنْتُمْ"]},
 {"id": "summary-10", "scene": "summary", "lang": "ar", "text": "أَنْتُنَّ", "pause": 0.3, "cues": ["hl:أَنْتُنَّ"]},
 {"id": "summary-11", "scene": "summary", "lang": "ar", "text": "هُوَ", "pause": 0.3, "cues": ["hl:هُوَ"]},
 {"id": "summary-12", "scene": "summary", "lang": "ar", "text": "هِيَ", "pause": 0.3, "cues": ["hl:هِيَ"]},
 {"id": "summary-13", "scene": "summary", "lang": "ar", "text": "هُمَا", "pause": 0.3, "cues": ["hl:هُمَا"]},
 {"id": "summary-14", "scene": "summary", "lang": "ar", "text": "هُمْ", "pause": 0.3, "cues": ["hl:هُمْ"]},
 {"id": "summary-15", "scene": "summary", "lang": "ar", "text": "هُنَّ", "pause": 0.6, "cues": ["hl:هُنَّ"]},
 {"id": "summary-16", "scene": "summary", "lang": "en", "text": "Choose by person: speaker, listener, absent.", "pause": 0.3, "cues": ["li:3"]},
 {"id": "summary-17", "scene": "summary", "lang": "en", "text": "By number: one, two, more. And by gender.", "pause": 0.5, "cues": []},
 {"id": "summary-18", "scene": "summary", "lang": "en", "text": "A pronoun never changes its ending, but it still has a job.", "pause": 0.5, "cues": ["li:4"]},
 {"id": "summary-19", "scene": "summary", "lang": "en", "text": "As the Topic, it is in the place of rafʿ.", "pause": 0.4, "cues": ["li:5"]},
 {"id": "summary-20", "scene": "summary", "lang": "ar", "text": "فِي مَحَلِّ رَفْعٍ", "pause": 0.9, "cues": ["hl:فِي مَحَلِّ رَفْعٍ"]},
 {"id": "outro-yourturn-01", "scene": "outro-yourturn", "lang": "en", "text": "Now it is your turn. Open the Practice tab.", "pause": 0.3, "cues": ["show"]},
 {"id": "outro-yourturn-02", "scene": "outro-yourturn", "lang": "en", "text": "There are six practice cards.", "pause": 0.3, "cues": []},
 {"id": "outro-yourturn-03", "scene": "outro-yourturn", "lang": "en", "text": "Which pronoun? What does it mean? Fixed or flexible?", "pause": 0.4, "cues": []},
 {"id": "outro-yourturn-04", "scene": "outro-yourturn", "lang": "en", "text": "Replace the word with a pronoun. Give the job, and rafʿ, naṣb or jarr. Then person and number.", "pause": 0.4, "cues": []},
 {"id": "outro-yourturn-05", "scene": "outro-yourturn", "lang": "en", "text": "Then do the homework. And read the table aloud, every day this week.", "pause": 0.9, "cues": []}
]}
