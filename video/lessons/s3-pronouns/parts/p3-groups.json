{"segments": [
 {"id": "c04-title-01", "scene": "c04-title", "lang": "en", "text": "Chapter four. Three groups.", "pause": 0.6, "cues": ["title"]},
 {"id": "c04-groups-01", "scene": "c04-groups", "lang": "en", "text": "The twelve pronouns fall into three groups. Each group is one person: first, second or third.", "pause": 0.4, "cues": []},
 {"id": "c04-groups-02", "scene": "c04-groups", "lang": "en", "text": "First person is the speaker.", "pause": 0.3, "cues": ["col:1"]},
 {"id": "c04-groups-03", "scene": "c04-groups", "lang": "ar", "text": "المُتَكَلِّمُ", "pause": 0.5, "cues": ["hl:المُتَكَلِّمُ"]},
 {"id": "c04-groups-04", "scene": "c04-groups", "lang": "en", "text": "Two words. I, and we.", "pause": 0.3, "cues": []},
 {"id": "c04-groups-05", "scene": "c04-groups", "lang": "ar", "text": "أَنَا", "pause": 0.3, "cues": []},
 {"id": "c04-groups-06", "scene": "c04-groups", "lang": "ar", "text": "نَحْنُ", "pause": 0.6, "cues": []},
 {"id": "c04-groups-07", "scene": "c04-groups", "lang": "en", "text": "Second person is the listener. The one you talk to.", "pause": 0.3, "cues": ["col:2"]},
 {"id": "c04-groups-08", "scene": "c04-groups", "lang": "ar", "text": "المُخَاطَبُ", "pause": 0.5, "cues": ["hl:المُخَاطَبُ"]},
 {"id": "c04-groups-09", "scene": "c04-groups", "lang": "en", "text": "Five words. They all begin the same way.", "pause": 0.3, "cues": []},
 {"id": "c04-groups-10", "scene": "c04-groups", "lang": "ar", "text": "أَنْتَ", "pause": 0.3, "cues": []},
 {"id": "c04-groups-11", "scene": "c04-groups", "lang": "ar", "text": "أَنْتِ", "pause": 0.3, "cues": []},
 {"id": "c04-groups-12", "scene": "c04-groups", "lang": "ar", "text": "أَنْتُمَا", "pause": 0.3, "cues": []},
 {"id": "c04-groups-13", "scene": "c04-groups", "lang": "ar", "text": "أَنْتُمْ", "pause": 0.3, "cues": []},
 {"id": "c04-groups-14", "scene": "c04-groups", "lang": "ar", "text": "أَنْتُنَّ", "pause": 0.6, "cues": []},
 {"id": "c04-groups-15", "scene": "c04-groups", "lang": "en", "text": "Third person is the absent one. The one you talk about.", "pause": 0.3, "cues": ["col:3"]},
 {"id": "c04-groups-16", "scene": "c04-groups", "lang": "ar", "text": "الغَائِبُ", "pause": 0.5, "cues": ["hl:الغَائِبُ"]},
 {"id": "c04-groups-17", "scene": "c04-groups", "lang": "en", "text": "Five words again.", "pause": 0.3, "cues": []},
 {"id": "c04-groups-18", "scene": "c04-groups", "lang": "ar", "text": "هُوَ", "pause": 0.3, "cues": []},
 {"id": "c04-groups-19", "scene": "c04-groups", "lang": "ar", "text": "هِيَ", "pause": 0.3, "cues": []},
 {"id": "c04-groups-20", "scene": "c04-groups", "lang": "ar", "text": "هُمَا", "pause": 0.3, "cues": []},
 {"id": "c04-groups-21", "scene": "c04-groups", "lang": "ar", "text": "هُمْ", "pause": 0.3, "cues": []},
 {"id": "c04-groups-22", "scene": "c04-groups", "lang": "ar", "text": "هُنَّ", "pause": 0.6, "cues": []},
 {"id": "c04-groups-23", "scene": "c04-groups", "lang": "en", "text": "Two, five and five. Twelve in all.", "pause": 0.8, "cues": []},
 {"id": "c04-tip1-01", "scene": "c04-tip1", "lang": "en", "text": "A tip about the words for he and she.", "pause": 0.4, "cues": ["show"]},
 {"id": "c04-tip1-02", "scene": "c04-tip1", "lang": "ar", "text": "هُوَ", "pause": 0.3, "cues": ["hl:هُوَ"]},
 {"id": "c04-tip1-03", "scene": "c04-tip1", "lang": "ar", "text": "هِيَ", "pause": 0.4, "cues": ["hl:هِيَ"]},
 {"id": "c04-tip1-04", "scene": "c04-tip1", "lang": "en", "text": "They are also used for things.", "pause": 0.4, "cues": ["hl:also used for things"]},
 {"id": "c04-tip1-05", "scene": "c04-tip1", "lang": "en", "text": "For a masculine noun, use", "pause": 0.2, "cues": []},
 {"id": "c04-tip1-06", "scene": "c04-tip1", "lang": "ar", "text": "هُوَ", "pause": 0.4, "cues": ["hl:هُوَ@2"]},
 {"id": "c04-tip1-07", "scene": "c04-tip1", "lang": "en", "text": "For a feminine noun, use", "pause": 0.2, "cues": []},
 {"id": "c04-tip1-08", "scene": "c04-tip1", "lang": "ar", "text": "هِيَ", "pause": 0.5, "cues": ["hl:هِيَ@2"]},
 {"id": "c04-tip1-09", "scene": "c04-tip1", "lang": "en", "text": "For example. Where is the watch? It is on the bed.", "pause": 0.4, "cues": []},
 {"id": "c04-tip1-10", "scene": "c04-tip1", "lang": "ar", "text": "أَيْنَ السَّاعَةُ؟ هِيَ عَلَى السَّرِيرِ", "pause": 0.5, "cues": ["hl:أَيْنَ السَّاعَةُ؟ هِيَ عَلَى السَّرِيرِ"]},
 {"id": "c04-tip1-11", "scene": "c04-tip1", "lang": "en", "text": "The watch is a feminine noun. So we use the word for she.", "pause": 0.8, "cues": []},
 {"id": "c04-tip2-01", "scene": "c04-tip2", "lang": "en", "text": "Another tip. For two people, there is one word. Men or women, it is the same.", "pause": 0.4, "cues": ["show"]},
 {"id": "c04-tip2-02", "scene": "c04-tip2", "lang": "en", "text": "Talking to two people.", "pause": 0.3, "cues": []},
 {"id": "c04-tip2-03", "scene": "c04-tip2", "lang": "ar", "text": "أَنْتُمَا", "pause": 0.5, "cues": ["hl:أَنْتُمَا"]},
 {"id": "c04-tip2-04", "scene": "c04-tip2", "lang": "en", "text": "Talking about two people.", "pause": 0.3, "cues": []},
 {"id": "c04-tip2-05", "scene": "c04-tip2", "lang": "ar", "text": "هُمَا", "pause": 0.5, "cues": ["hl:هُمَا"]},
 {"id": "c04-tip2-06", "scene": "c04-tip2", "lang": "en", "text": "For a group of men and women together, talking to them.", "pause": 0.3, "cues": ["hl:a group of men and women together"]},
 {"id": "c04-tip2-07", "scene": "c04-tip2", "lang": "ar", "text": "أَنْتُمْ", "pause": 0.5, "cues": ["hl:أَنْتُمْ"]},
 {"id": "c04-tip2-08", "scene": "c04-tip2", "lang": "en", "text": "Talking about them.", "pause": 0.3, "cues": []},
 {"id": "c04-tip2-09", "scene": "c04-tip2", "lang": "ar", "text": "هُمْ", "pause": 0.8, "cues": ["hl:هُمْ"]}
]}
