{"segments": [
 {"id": "c04-title-01", "scene": "c04-title", "lang": "en", "text": "Chapter four. The answer ḥarfs.", "pause": 0.3, "cues": ["title"]},
 {"id": "c04-title-02", "scene": "c04-title", "lang": "ar", "text": "حُرُوفُ الجَوَابِ", "pause": 0.7, "cues": []},
 {"id": "c04-table-01", "scene": "c04-table", "lang": "ar", "text": "نَعَمْ", "pause": 0.4, "cues": ["row:1", "mark:1"]},
 {"id": "c04-table-02", "scene": "c04-table", "lang": "en", "text": "Yes.", "pause": 0.3, "cues": []},
 {"id": "c04-table-03", "scene": "c04-table", "lang": "ar", "text": "أَهَذَا بَيْتٌ؟", "pause": 0.5, "cues": []},
 {"id": "c04-table-04", "scene": "c04-table", "lang": "en", "text": "Is this a house?", "pause": 0.5, "cues": []},
 {"id": "c04-table-05", "scene": "c04-table", "lang": "ar", "text": "نَعَمْ، هَذَا بَيْتٌ", "pause": 0.4, "cues": []},
 {"id": "c04-table-06", "scene": "c04-table", "lang": "en", "text": "Yes, this is a house.", "pause": 0.5, "cues": []},
 {"id": "c04-table-07", "scene": "c04-table", "lang": "ar", "text": "لَا", "pause": 0.4, "cues": ["row:2", "mark:2"]},
 {"id": "c04-table-08", "scene": "c04-table", "lang": "en", "text": "No.", "pause": 0.3, "cues": []},
 {"id": "c04-table-09", "scene": "c04-table", "lang": "ar", "text": "أَهَذَا بَيْتٌ؟", "pause": 0.5, "cues": []},
 {"id": "c04-table-10", "scene": "c04-table", "lang": "ar", "text": "لَا، هَذَا مَسْجِدٌ", "pause": 0.4, "cues": []},
 {"id": "c04-table-11", "scene": "c04-table", "lang": "en", "text": "No, this is a mosque.", "pause": 0.5, "cues": []},
 {"id": "c04-table-12", "scene": "c04-table", "lang": "ar", "text": "بَلَى", "pause": 0.4, "cues": ["row:3", "mark:3"]},
 {"id": "c04-table-13", "scene": "c04-table", "lang": "en", "text": "It means yes, to a question with the word not in it.", "pause": 0.3, "cues": []},
 {"id": "c04-table-14", "scene": "c04-table", "lang": "ar", "text": "أَمَا ذَهَبْتَ إِلَى المَسْجِدِ؟", "pause": 0.5, "cues": []},
 {"id": "c04-table-15", "scene": "c04-table", "lang": "en", "text": "Didn't you go to the mosque?", "pause": 0.5, "cues": []},
 {"id": "c04-table-16", "scene": "c04-table", "lang": "ar", "text": "بَلَى، ذَهَبْتُ", "pause": 0.4, "cues": []},
 {"id": "c04-table-17", "scene": "c04-table", "lang": "en", "text": "Yes, I did.", "pause": 0.7, "cues": []},
 {"id": "c04-rule-01", "scene": "c04-rule", "lang": "en", "text": "So when do we use this one?", "pause": 0.5, "cues": ["show"]},
 {"id": "c04-rule-02", "scene": "c04-rule", "lang": "ar", "text": "بَلَى", "pause": 0.4, "cues": []},
 {"id": "c04-rule-03", "scene": "c04-rule", "lang": "en", "text": "Use it when the question has the word not in it, and your answer is yes.", "pause": 0.4, "cues": ["hl:when the question has \"not\" in it and your answer is yes"]},
 {"id": "c04-rule-04", "scene": "c04-rule", "lang": "en", "text": "Didn't you go? Yes, I did.", "pause": 0.7, "cues": []},
 {"id": "c04-tip-01", "scene": "c04-tip", "lang": "en", "text": "A tip. Look at the question again.", "pause": 0.3, "cues": ["show"]},
 {"id": "c04-tip-02", "scene": "c04-tip", "lang": "ar", "text": "أَمَا ذَهَبْتَ؟", "pause": 0.6, "cues": []},
 {"id": "c04-tip-03", "scene": "c04-tip", "lang": "en", "text": "Inside it is this ḥarf.", "pause": 0.3, "cues": []},
 {"id": "c04-tip-04", "scene": "c04-tip", "lang": "ar", "text": "مَا", "pause": 0.4, "cues": []},
 {"id": "c04-tip-05", "scene": "c04-tip", "lang": "en", "text": "It means did not. You met it in unit six.", "pause": 0.3, "cues": ["hl:is the \"did not\" ḥarf from unit 6"]},
 {"id": "c04-tip-06", "scene": "c04-tip", "lang": "ar", "text": "مَا ذَهَبْتَ", "pause": 0.4, "cues": []},
 {"id": "c04-tip-07", "scene": "c04-tip", "lang": "en", "text": "You did not go.", "pause": 0.4, "cues": []},
 {"id": "c04-tip-08", "scene": "c04-tip", "lang": "en", "text": "Now add the joined question ḥarf in front.", "pause": 0.3, "cues": []},
 {"id": "c04-tip-09", "scene": "c04-tip", "lang": "ar", "text": "أَمَا ذَهَبْتَ؟", "pause": 0.5, "cues": []},
 {"id": "c04-tip-10", "scene": "c04-tip", "lang": "en", "text": "Now it is a question. Didn't you go?", "pause": 0.8, "cues": ["hl:\"Didn't you go?\""]},
 {"id": "c05-title-01", "scene": "c05-title", "lang": "en", "text": "Chapter five. The question ḥarfs.", "pause": 0.3, "cues": ["title"]},
 {"id": "c05-title-02", "scene": "c05-title", "lang": "en", "text": "You met them in unit five. They make a yes or no question.", "pause": 0.3, "cues": ["sub"]},
 {"id": "c05-title-03", "scene": "c05-title", "lang": "en", "text": "They are ḥarfs, so they have no place.", "pause": 0.3, "cues": ["hl:They are ḥarfs, so they have no place."]},
 {"id": "c05-title-04", "scene": "c05-title", "lang": "en", "text": "The question words who, what and where are different.", "pause": 0.3, "cues": []},
 {"id": "c05-title-05", "scene": "c05-title", "lang": "en", "text": "They are isms, and they do have a place.", "pause": 0.7, "cues": ["hl:are isms and do have a place"]},
 {"id": "c05-table-01", "scene": "c05-table", "lang": "ar", "text": "هَلْ", "pause": 0.4, "cues": ["row:1", "mark:1"]},
 {"id": "c05-table-02", "scene": "c05-table", "lang": "en", "text": "It makes a yes or no question.", "pause": 0.3, "cues": []},
 {"id": "c05-table-03", "scene": "c05-table", "lang": "ar", "text": "هَلْ ذَهَبَ مُحَمَّدٌ إِلَى السُّوقِ؟", "pause": 0.5, "cues": []},
 {"id": "c05-table-04", "scene": "c05-table", "lang": "en", "text": "Did Muhammad go to the market?", "pause": 0.5, "cues": []},
 {"id": "c05-table-05", "scene": "c05-table", "lang": "en", "text": "The second one does the same job. It is written joined to the next word.", "pause": 0.3, "cues": ["row:2", "mark:2"]},
 {"id": "c05-table-06", "scene": "c05-table", "lang": "ar", "text": "أَهَذَا بَيْتٌ؟", "pause": 0.5, "cues": []},
 {"id": "c05-table-07", "scene": "c05-table", "lang": "en", "text": "Is this a house?", "pause": 0.8, "cues": []}
]}
