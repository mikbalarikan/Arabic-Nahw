{"segments": [
 {"id": "c06-title-01", "scene": "c06-title", "lang": "en", "text": "Chapter six. The calling ḥarf.", "pause": 0.3, "cues": ["title"]},
 {"id": "c06-title-02", "scene": "c06-title", "lang": "ar", "text": "يَا", "pause": 0.5, "cues": []},
 {"id": "c06-title-03", "scene": "c06-title", "lang": "en", "text": "Use it to call someone.", "pause": 0.3, "cues": ["sub"]},
 {"id": "c06-title-04", "scene": "c06-title", "lang": "en", "text": "After it, a name, or a single noun for the person you call, takes one damma.", "pause": 0.3, "cues": ["hl:takes one damma"]},
 {"id": "c06-title-05", "scene": "c06-title", "lang": "en", "text": "It never takes tanween.", "pause": 0.3, "cues": ["hl:It never takes tanween."]},
 {"id": "c06-title-06", "scene": "c06-title", "lang": "en", "text": "This damma is fixed.", "pause": 0.3, "cues": ["hl:This damma is fixed."]},
 {"id": "c06-title-07", "scene": "c06-title", "lang": "en", "text": "The called word is in the place of naṣb.", "pause": 0.3, "cues": ["hl:The called word is in the place of naṣb"]},
 {"id": "c06-title-08", "scene": "c06-title", "lang": "ar", "text": "فِي مَحَلِّ نَصْبٍ", "pause": 0.7, "cues": []},
 {"id": "c06-table-01", "scene": "c06-table", "lang": "en", "text": "Muhammad has tanween.", "pause": 0.3, "cues": ["row:1", "mark:1"]},
 {"id": "c06-table-02", "scene": "c06-table", "lang": "ar", "text": "مُحَمَّدٌ", "pause": 0.4, "cues": []},
 {"id": "c06-table-03", "scene": "c06-table", "lang": "en", "text": "When we call him, one damma only.", "pause": 0.3, "cues": []},
 {"id": "c06-table-04", "scene": "c06-table", "lang": "ar", "text": "يَا مُحَمَّدُ", "pause": 0.4, "cues": []},
 {"id": "c06-table-05", "scene": "c06-table", "lang": "en", "text": "O Muhammad.", "pause": 0.5, "cues": []},
 {"id": "c06-table-06", "scene": "c06-table", "lang": "ar", "text": "عَلِيٌّ", "pause": 0.4, "cues": ["row:2", "mark:2"]},
 {"id": "c06-table-07", "scene": "c06-table", "lang": "ar", "text": "يَا عَلِيُّ", "pause": 0.4, "cues": []},
 {"id": "c06-table-08", "scene": "c06-table", "lang": "en", "text": "O Ali.", "pause": 0.5, "cues": []},
 {"id": "c06-table-09", "scene": "c06-table", "lang": "ar", "text": "آمِنَةُ", "pause": 0.4, "cues": ["row:3", "mark:3"]},
 {"id": "c06-table-10", "scene": "c06-table", "lang": "en", "text": "Aminah already ends in one damma, with no tanween.", "pause": 0.3, "cues": []},
 {"id": "c06-table-11", "scene": "c06-table", "lang": "ar", "text": "يَا آمِنَةُ", "pause": 0.4, "cues": []},
 {"id": "c06-table-12", "scene": "c06-table", "lang": "en", "text": "O Aminah.", "pause": 0.5, "cues": []},
 {"id": "c06-table-13", "scene": "c06-table", "lang": "en", "text": "A single noun for a person works the same way.", "pause": 0.3, "cues": ["row:4", "mark:4"]},
 {"id": "c06-table-14", "scene": "c06-table", "lang": "ar", "text": "وَلَدٌ", "pause": 0.4, "cues": []},
 {"id": "c06-table-15", "scene": "c06-table", "lang": "ar", "text": "يَا وَلَدُ", "pause": 0.4, "cues": []},
 {"id": "c06-table-16", "scene": "c06-table", "lang": "en", "text": "O boy.", "pause": 0.5, "cues": []},
 {"id": "c06-table-17", "scene": "c06-table", "lang": "ar", "text": "أُسْتَاذٌ", "pause": 0.4, "cues": ["row:5", "mark:5"]},
 {"id": "c06-table-18", "scene": "c06-table", "lang": "ar", "text": "يَا أُسْتَاذُ", "pause": 0.4, "cues": []},
 {"id": "c06-table-19", "scene": "c06-table", "lang": "en", "text": "O teacher.", "pause": 0.4, "cues": []},
 {"id": "c06-table-20", "scene": "c06-table", "lang": "en", "text": "Each called word ends in one damma, with no tanween.", "pause": 0.7, "cues": ["mark:0"]},
 {"id": "c06-tip-01", "scene": "c06-tip", "lang": "en", "text": "A tip. This is the same as lesson five of the Madinah book.", "pause": 0.4, "cues": ["show"]},
 {"id": "c06-tip-02", "scene": "c06-tip", "lang": "ar", "text": "يَا بِلَالُ", "pause": 0.4, "cues": []},
 {"id": "c06-tip-03", "scene": "c06-tip", "lang": "ar", "text": "يَا شَيْخُ", "pause": 0.4, "cues": []},
 {"id": "c06-tip-04", "scene": "c06-tip", "lang": "en", "text": "O Bilal. O old man.", "pause": 0.8, "cues": []},
 {"id": "c07-title-01", "scene": "c07-title", "lang": "en", "text": "Chapter seven. A ḥarf or an ism? Look-alikes.", "pause": 0.3, "cues": ["title"]},
 {"id": "c07-title-02", "scene": "c07-title", "lang": "en", "text": "Some ḥarfs look like isms. And some short question words are isms.", "pause": 0.3, "cues": ["sub"]},
 {"id": "c07-title-03", "scene": "c07-title", "lang": "en", "text": "Read the vowels carefully.", "pause": 0.7, "cues": ["hl:Read the vowels carefully."]},
 {"id": "c07-table-01", "scene": "c07-table", "lang": "ar", "text": "مِنْ", "pause": 0.4, "cues": ["row:1", "mark:1"]},
 {"id": "c07-table-02", "scene": "c07-table", "lang": "en", "text": "From. A ḥarf.", "pause": 0.3, "cues": []},
 {"id": "c07-table-03", "scene": "c07-table", "lang": "ar", "text": "مَنْ", "pause": 0.4, "cues": []},
 {"id": "c07-table-04", "scene": "c07-table", "lang": "en", "text": "Who. An ism. Only the first vowel is different.", "pause": 0.5, "cues": []},
 {"id": "c07-table-05", "scene": "c07-table", "lang": "ar", "text": "عَلَى", "pause": 0.4, "cues": ["row:2", "mark:2"]},
 {"id": "c07-table-06", "scene": "c07-table", "lang": "en", "text": "On. A ḥarf.", "pause": 0.3, "cues": []},
 {"id": "c07-table-07", "scene": "c07-table", "lang": "ar", "text": "عَلِيٌّ", "pause": 0.4, "cues": []},
 {"id": "c07-table-08", "scene": "c07-table", "lang": "en", "text": "Ali, a name. An ism.", "pause": 0.5, "cues": []},
 {"id": "c07-table-09", "scene": "c07-table", "lang": "ar", "text": "هَلْ", "pause": 0.4, "cues": ["row:3", "mark:3"]},
 {"id": "c07-table-10", "scene": "c07-table", "lang": "en", "text": "It starts a yes or no question. A ḥarf.", "pause": 0.3, "cues": []},
 {"id": "c07-table-11", "scene": "c07-table", "lang": "ar", "text": "أَيْنَ", "pause": 0.4, "cues": []},
 {"id": "c07-table-12", "scene": "c07-table", "lang": "en", "text": "Where. An ism. Both are used in questions. Only one is a ḥarf.", "pause": 0.5, "cues": []},
 {"id": "c07-table-13", "scene": "c07-table", "lang": "en", "text": "Next, the ḥarf that means like. It is written joined to the next word.", "pause": 0.3, "cues": ["row:4", "mark:4"]},
 {"id": "c07-table-14", "scene": "c07-table", "lang": "ar", "text": "كَمْ", "pause": 0.4, "cues": []},
 {"id": "c07-table-15", "scene": "c07-table", "lang": "en", "text": "How many. An ism. Both start with the same letter.", "pause": 0.7, "cues": []},
 {"id": "summary-01", "scene": "summary", "lang": "en", "text": "In short.", "pause": 0.3, "cues": []},
 {"id": "summary-02", "scene": "summary", "lang": "en", "text": "Every ḥarf is fixed and has no place.", "pause": 0.3, "cues": ["q:1"]},
 {"id": "summary-03", "scene": "summary", "lang": "ar", "text": "لَا مَحَلَّ لَهُ مِنَ الإِعْرَابِ", "pause": 0.5, "cues": []},
 {"id": "summary-04", "scene": "summary", "lang": "en", "text": "After a jarr ḥarf, the next noun is jarr.", "pause": 0.4, "cues": ["q:2"]},
 {"id": "summary-05", "scene": "summary", "lang": "en", "text": "After a joining ḥarf, the next word copies the ending of the word before.", "pause": 0.4, "cues": ["q:3"]},
 {"id": "summary-06", "scene": "summary", "lang": "en", "text": "The answer ḥarfs say yes and no.", "pause": 0.3, "cues": ["q:4"]},
 {"id": "summary-07", "scene": "summary", "lang": "ar", "text": "بَلَى", "pause": 0.4, "cues": []},
 {"id": "summary-08", "scene": "summary", "lang": "en", "text": "This one says yes to a question with the word not in it.", "pause": 0.4, "cues": []},
 {"id": "summary-09", "scene": "summary", "lang": "en", "text": "The question ḥarfs make a yes or no question.", "pause": 0.3, "cues": ["q:5"]},
 {"id": "summary-10", "scene": "summary", "lang": "en", "text": "After the calling ḥarf, a name takes one damma.", "pause": 0.3, "cues": []},
 {"id": "summary-11", "scene": "summary", "lang": "ar", "text": "يَا مُحَمَّدُ", "pause": 0.6, "cues": []},
 {"id": "summary-12", "scene": "summary", "lang": "en", "text": "Now it is your turn. Open the Practice tab.", "pause": 1.0, "cues": []}
]}
