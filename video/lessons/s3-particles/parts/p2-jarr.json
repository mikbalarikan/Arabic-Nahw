{"segments": [
 {"id": "c02-title-01", "scene": "c02-title", "lang": "en", "text": "Chapter two. The jarr ḥarfs.", "pause": 0.3, "cues": ["title"]},
 {"id": "c02-title-02", "scene": "c02-title", "lang": "ar", "text": "حُرُوفُ الجَرِّ", "pause": 0.5, "cues": []},
 {"id": "c02-title-03", "scene": "c02-title", "lang": "en", "text": "You know four of them from Stage one. Here are nine.", "pause": 0.3, "cues": ["sub"]},
 {"id": "c02-title-04", "scene": "c02-title", "lang": "en", "text": "The noun after each one is jarr.", "pause": 0.7, "cues": ["hl:The noun after each one is jarr."]},
 {"id": "c02-table-01", "scene": "c02-table", "lang": "ar", "text": "مِنْ", "pause": 0.4, "cues": ["row:1", "mark:1"]},
 {"id": "c02-table-02", "scene": "c02-table", "lang": "en", "text": "From.", "pause": 0.3, "cues": []},
 {"id": "c02-table-03", "scene": "c02-table", "lang": "ar", "text": "خَرَجَ مِنَ البَيْتِ", "pause": 0.4, "cues": []},
 {"id": "c02-table-04", "scene": "c02-table", "lang": "en", "text": "He went out of the house. The house is jarr, with kasra.", "pause": 0.5, "cues": []},
 {"id": "c02-table-05", "scene": "c02-table", "lang": "ar", "text": "إِلَى", "pause": 0.4, "cues": ["row:2", "mark:2"]},
 {"id": "c02-table-06", "scene": "c02-table", "lang": "en", "text": "To.", "pause": 0.3, "cues": []},
 {"id": "c02-table-07", "scene": "c02-table", "lang": "ar", "text": "ذَهَبَ إِلَى المَسْجِدِ", "pause": 0.4, "cues": []},
 {"id": "c02-table-08", "scene": "c02-table", "lang": "en", "text": "He went to the mosque.", "pause": 0.5, "cues": []},
 {"id": "c02-table-09", "scene": "c02-table", "lang": "ar", "text": "عَنْ", "pause": 0.4, "cues": ["row:3", "mark:3"]},
 {"id": "c02-table-10", "scene": "c02-table", "lang": "en", "text": "About, or away from.", "pause": 0.3, "cues": []},
 {"id": "c02-table-11", "scene": "c02-table", "lang": "ar", "text": "الدَّرْسُ عَنِ القَمَرِ", "pause": 0.4, "cues": []},
 {"id": "c02-table-12", "scene": "c02-table", "lang": "en", "text": "The lesson is about the moon.", "pause": 0.5, "cues": []},
 {"id": "c02-table-13", "scene": "c02-table", "lang": "ar", "text": "عَلَى", "pause": 0.4, "cues": ["row:4", "mark:4"]},
 {"id": "c02-table-14", "scene": "c02-table", "lang": "en", "text": "On.", "pause": 0.3, "cues": []},
 {"id": "c02-table-15", "scene": "c02-table", "lang": "ar", "text": "الكِتَابُ عَلَى المَكْتَبِ", "pause": 0.4, "cues": []},
 {"id": "c02-table-16", "scene": "c02-table", "lang": "en", "text": "The book is on the desk.", "pause": 0.5, "cues": []},
 {"id": "c02-table-17", "scene": "c02-table", "lang": "ar", "text": "فِي", "pause": 0.4, "cues": ["row:5", "mark:5"]},
 {"id": "c02-table-18", "scene": "c02-table", "lang": "en", "text": "In.", "pause": 0.3, "cues": []},
 {"id": "c02-table-19", "scene": "c02-table", "lang": "ar", "text": "الطَّالِبُ فِي الفَصْلِ", "pause": 0.4, "cues": []},
 {"id": "c02-table-20", "scene": "c02-table", "lang": "en", "text": "The student is in the classroom.", "pause": 0.5, "cues": []},
 {"id": "c02-table-21", "scene": "c02-table", "lang": "en", "text": "The sixth ḥarf means with, or by. It is written joined to the word after it.", "pause": 0.4, "cues": ["row:6", "mark:6"]},
 {"id": "c02-table-22", "scene": "c02-table", "lang": "ar", "text": "كَتَبْتُ بِالقَلَمِ", "pause": 0.4, "cues": []},
 {"id": "c02-table-23", "scene": "c02-table", "lang": "en", "text": "I wrote with the pen.", "pause": 0.5, "cues": []},
 {"id": "c02-table-24", "scene": "c02-table", "lang": "en", "text": "The seventh means for, or belongs to. It is joined too.", "pause": 0.4, "cues": ["row:7", "mark:7"]},
 {"id": "c02-table-25", "scene": "c02-table", "lang": "ar", "text": "الكِتَابُ لِمُحَمَّدٍ", "pause": 0.4, "cues": []},
 {"id": "c02-table-26", "scene": "c02-table", "lang": "en", "text": "The book belongs to Muhammad.", "pause": 0.5, "cues": []},
 {"id": "c02-table-27", "scene": "c02-table", "lang": "en", "text": "The eighth means like. It is joined too.", "pause": 0.4, "cues": ["row:8", "mark:8"]},
 {"id": "c02-table-28", "scene": "c02-table", "lang": "ar", "text": "البِنْتُ كَالقَمَرِ", "pause": 0.4, "cues": []},
 {"id": "c02-table-29", "scene": "c02-table", "lang": "en", "text": "The girl is like the moon.", "pause": 0.5, "cues": []},
 {"id": "c02-table-30", "scene": "c02-table", "lang": "ar", "text": "حَتَّى", "pause": 0.4, "cues": ["row:9", "mark:9"]},
 {"id": "c02-table-31", "scene": "c02-table", "lang": "en", "text": "Until.", "pause": 0.3, "cues": []},
 {"id": "c02-table-32", "scene": "c02-table", "lang": "ar", "text": "جَلَسْتُ فِي المَسْجِدِ حَتَّى الظُّهْرِ", "pause": 0.4, "cues": []},
 {"id": "c02-table-33", "scene": "c02-table", "lang": "en", "text": "I sat in the mosque until noon.", "pause": 0.5, "cues": []},
 {"id": "c02-table-34", "scene": "c02-table", "lang": "en", "text": "In every example, the noun after the ḥarf is jarr.", "pause": 0.7, "cues": ["mark:0"]},
 {"id": "c02-rule-01", "scene": "c02-rule", "lang": "en", "text": "Two small changes before al.", "pause": 0.4, "cues": ["show"]},
 {"id": "c02-rule-02", "scene": "c02-rule", "lang": "en", "text": "Look at the ḥarf that means from. It ends in sukūn.", "pause": 0.3, "cues": []},
 {"id": "c02-rule-03", "scene": "c02-rule", "lang": "ar", "text": "مِنْ", "pause": 0.4, "cues": []},
 {"id": "c02-rule-04", "scene": "c02-rule", "lang": "en", "text": "Before al, it takes a fatha.", "pause": 0.3, "cues": ["hl:مِنْ becomes مِنَ: مِنَ البَيْتِ."]},
 {"id": "c02-rule-05", "scene": "c02-rule", "lang": "ar", "text": "مِنَ البَيْتِ", "pause": 0.5, "cues": []},
 {"id": "c02-rule-06", "scene": "c02-rule", "lang": "en", "text": "The ḥarf that means about also ends in sukūn.", "pause": 0.3, "cues": []},
 {"id": "c02-rule-07", "scene": "c02-rule", "lang": "ar", "text": "عَنْ", "pause": 0.4, "cues": []},
 {"id": "c02-rule-08", "scene": "c02-rule", "lang": "en", "text": "Before al, it takes a kasra.", "pause": 0.3, "cues": ["hl:عَنْ becomes عَنِ: عَنِ القَمَرِ."]},
 {"id": "c02-rule-09", "scene": "c02-rule", "lang": "ar", "text": "عَنِ القَمَرِ", "pause": 0.5, "cues": []},
 {"id": "c02-rule-10", "scene": "c02-rule", "lang": "en", "text": "This is only a helping vowel for easy speaking. The ḥarf is still fixed.", "pause": 0.7, "cues": []},
 {"id": "c02-tip-01", "scene": "c02-tip", "lang": "en", "text": "A tip. Three of these ḥarfs are written joined to the next word.", "pause": 0.3, "cues": ["show", "hl:are written joined to the next word"]},
 {"id": "c02-tip-02", "scene": "c02-tip", "lang": "en", "text": "They mean with, for, and like.", "pause": 0.4, "cues": []},
 {"id": "c02-tip-03", "scene": "c02-tip", "lang": "en", "text": "Look at the ḥarf that means for. Before al, the alif of al drops out.", "pause": 0.3, "cues": ["hl:drops the alif"]},
 {"id": "c02-tip-04", "scene": "c02-tip", "lang": "ar", "text": "لِلمُدَرِّسِ", "pause": 0.4, "cues": []},
 {"id": "c02-tip-05", "scene": "c02-tip", "lang": "en", "text": "For the teacher.", "pause": 0.8, "cues": []}
]}
