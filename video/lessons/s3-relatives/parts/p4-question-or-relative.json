{"segments": [
 {"id": "c04-title-01", "scene": "c04-title", "lang": "en", "text": "Chapter four.", "pause": 0.3, "cues": ["title"]},
 {"id": "c04-title-02", "scene": "c04-title", "lang": "ar", "text": "مَنْ", "pause": 0.3, "cues": ["ar:0"]},
 {"id": "c04-title-03", "scene": "c04-title", "lang": "en", "text": "and", "pause": 0.2, "cues": []},
 {"id": "c04-title-04", "scene": "c04-title", "lang": "ar", "text": "مَا", "pause": 0.4, "cues": ["ar:1"]},
 {"id": "c04-title-05", "scene": "c04-title", "lang": "en", "text": "Question or relative?", "pause": 0.6, "cues": []},
 {"id": "c04-title-06", "scene": "c04-title", "lang": "en", "text": "These two words are also question words. You learn them as question words in unit five.", "pause": 0.4, "cues": ["sub"]},
 {"id": "c04-title-07", "scene": "c04-title", "lang": "en", "text": "So how do we tell them apart? Look at the sentence.", "pause": 0.4, "cues": []},
 {"id": "c04-title-08", "scene": "c04-title", "lang": "en", "text": "A question ends in a question mark.", "pause": 0.3, "cues": ["ar:4"]},
 {"id": "c04-title-09", "scene": "c04-title", "lang": "en", "text": "A relative sits inside a normal sentence. It means the one who, or what.", "pause": 0.7, "cues": []},
 {"id": "c04-ex-01", "scene": "c04-ex", "lang": "en", "text": "Who passed?", "pause": 0.4, "cues": ["ex:1"]},
 {"id": "c04-ex-02", "scene": "c04-ex", "lang": "ar", "text": "مَنْ نَجَحَ", "pause": 0.5, "cues": ["ar:0"]},
 {"id": "c04-ex-03", "scene": "c04-ex", "lang": "en", "text": "It ends in a question mark. So this is a question.", "pause": 0.6, "cues": ["note:1"]},
 {"id": "c04-ex-04", "scene": "c04-ex", "lang": "en", "text": "The one who passed came.", "pause": 0.4, "cues": ["ex:2"]},
 {"id": "c04-ex-05", "scene": "c04-ex", "lang": "ar", "text": "جَاءَ مَنْ نَجَحَ", "pause": 0.5, "cues": ["ar:1"]},
 {"id": "c04-ex-06", "scene": "c04-ex", "lang": "en", "text": "This is a normal sentence. So the word is a relative here. It means the one who.", "pause": 0.4, "cues": ["note:2"]},
 {"id": "c04-ex-07", "scene": "c04-ex", "lang": "en", "text": "Its ṣila is the verb. It means he passed.", "pause": 0.4, "cues": []},
 {"id": "c04-ex-08", "scene": "c04-ex", "lang": "ar", "text": "نَجَحَ", "pause": 0.6, "cues": ["ar:2"]},
 {"id": "c04-ex-09", "scene": "c04-ex", "lang": "en", "text": "What is on the desk?", "pause": 0.4, "cues": ["ex:3"]},
 {"id": "c04-ex-10", "scene": "c04-ex", "lang": "ar", "text": "مَا عَلَى الْمَكْتَبِ", "pause": 0.5, "cues": ["ar:3"]},
 {"id": "c04-ex-11", "scene": "c04-ex", "lang": "en", "text": "Again, a question mark. So it is a question.", "pause": 0.6, "cues": ["note:3"]},
 {"id": "c04-ex-12", "scene": "c04-ex", "lang": "en", "text": "Read what is on the desk.", "pause": 0.4, "cues": ["ex:4"]},
 {"id": "c04-ex-13", "scene": "c04-ex", "lang": "ar", "text": "اِقْرَأْ مَا عَلَى الْمَكْتَبِ", "pause": 0.5, "cues": ["ar:4"]},
 {"id": "c04-ex-14", "scene": "c04-ex", "lang": "en", "text": "This is an order, with no question mark. So the word is a relative here. It means what.", "pause": 0.8, "cues": ["note:4"]}
]}
