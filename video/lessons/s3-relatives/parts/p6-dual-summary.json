{"segments": [
 {"id": "c06-title-01", "scene": "c06-title", "lang": "en", "text": "Chapter six. Not fixed.", "pause": 0.4, "cues": ["title"]},
 {"id": "c06-title-02", "scene": "c06-title", "lang": "ar", "text": "اللَّذَانِ", "pause": 0.3, "cues": ["ar:0"]},
 {"id": "c06-title-03", "scene": "c06-title", "lang": "en", "text": "and", "pause": 0.2, "cues": []},
 {"id": "c06-title-04", "scene": "c06-title", "lang": "ar", "text": "اللَّتَانِ", "pause": 0.7, "cues": ["ar:1"]},
 {"id": "c06-forms-01", "scene": "c06-forms", "lang": "en", "text": "Careful. Two more relatives mean the two who. And these words change.", "pause": 0.4, "cues": ["show:1"]},
 {"id": "c06-forms-02", "scene": "c06-forms", "lang": "en", "text": "This one is for two males.", "pause": 0.4, "cues": []},
 {"id": "c06-forms-03", "scene": "c06-forms", "lang": "ar", "text": "اللَّذَانِ", "pause": 0.5, "cues": ["ar:0"]},
 {"id": "c06-forms-04", "scene": "c06-forms", "lang": "en", "text": "This one is for two females.", "pause": 0.4, "cues": []},
 {"id": "c06-forms-05", "scene": "c06-forms", "lang": "ar", "text": "اللَّتَانِ", "pause": 0.5, "cues": ["ar:1"]},
 {"id": "c06-forms-06", "scene": "c06-forms", "lang": "en", "text": "These two are not fixed. They are flexible.", "pause": 0.4, "cues": ["hl:are flexible"]},
 {"id": "c06-forms-07", "scene": "c06-forms", "lang": "en", "text": "In naṣb and jarr, they become these.", "pause": 0.4, "cues": []},
 {"id": "c06-forms-08", "scene": "c06-forms", "lang": "ar", "text": "اللَّذَيْنِ", "pause": 0.35, "cues": ["ar:2"]},
 {"id": "c06-forms-09", "scene": "c06-forms", "lang": "ar", "text": "اللَّتَيْنِ", "pause": 0.6, "cues": ["ar:3"]},
 {"id": "c06-forms-10", "scene": "c06-forms", "lang": "en", "text": "You learn them with the dual in Stage 4.", "pause": 0.4, "cues": ["hl:You learn them with the dual in Stage 4"]},
 {"id": "c06-forms-11", "scene": "c06-forms", "lang": "en", "text": "Here they are as a table.", "pause": 0.4, "cues": ["show:2"]},
 {"id": "c06-forms-12", "scene": "c06-forms", "lang": "en", "text": "In rafʿ, for two males and for two females.", "pause": 0.4, "cues": []},
 {"id": "c06-forms-13", "scene": "c06-forms", "lang": "ar", "text": "اللَّذَانِ", "pause": 0.35, "cues": ["ar:4"]},
 {"id": "c06-forms-14", "scene": "c06-forms", "lang": "ar", "text": "اللَّتَانِ", "pause": 0.5, "cues": ["ar:5"]},
 {"id": "c06-forms-15", "scene": "c06-forms", "lang": "en", "text": "In naṣb and jarr, for two males and for two females.", "pause": 0.4, "cues": []},
 {"id": "c06-forms-16", "scene": "c06-forms", "lang": "ar", "text": "اللَّذَيْنِ", "pause": 0.35, "cues": ["ar:6"]},
 {"id": "c06-forms-17", "scene": "c06-forms", "lang": "ar", "text": "اللَّتَيْنِ", "pause": 0.5, "cues": ["ar:7"]},
 {"id": "c06-forms-18", "scene": "c06-forms", "lang": "en", "text": "For now, know that they change.", "pause": 0.8, "cues": []},
 {"id": "summary-01", "scene": "summary", "lang": "en", "text": "In short.", "pause": 0.5, "cues": []},
 {"id": "summary-02", "scene": "summary", "lang": "en", "text": "One. For one male or thing.", "pause": 0.3, "cues": ["li:1"]},
 {"id": "summary-03", "scene": "summary", "lang": "ar", "text": "الَّذِي", "pause": 0.4, "cues": ["ar:0"]},
 {"id": "summary-04", "scene": "summary", "lang": "en", "text": "For one female or thing.", "pause": 0.4, "cues": []},
 {"id": "summary-05", "scene": "summary", "lang": "ar", "text": "الَّتِي", "pause": 0.4, "cues": ["ar:1"]},
 {"id": "summary-06", "scene": "summary", "lang": "en", "text": "For males.", "pause": 0.4, "cues": []},
 {"id": "summary-07", "scene": "summary", "lang": "ar", "text": "الَّذِينَ", "pause": 0.4, "cues": ["ar:2"]},
 {"id": "summary-08", "scene": "summary", "lang": "en", "text": "For females.", "pause": 0.4, "cues": []},
 {"id": "summary-09", "scene": "summary", "lang": "ar", "text": "اللَّاتِي", "pause": 0.3, "cues": ["ar:3"]},
 {"id": "summary-10", "scene": "summary", "lang": "ar", "text": "اللَّوَاتِي", "pause": 0.6, "cues": ["ar:4"]},
 {"id": "summary-11", "scene": "summary", "lang": "en", "text": "Two. The one who, for people.", "pause": 0.3, "cues": ["li:2"]},
 {"id": "summary-12", "scene": "summary", "lang": "ar", "text": "مَنْ", "pause": 0.4, "cues": ["ar:5"]},
 {"id": "summary-13", "scene": "summary", "lang": "en", "text": "What, for things.", "pause": 0.4, "cues": []},
 {"id": "summary-14", "scene": "summary", "lang": "ar", "text": "مَا", "pause": 0.6, "cues": ["ar:6"]},
 {"id": "summary-15", "scene": "summary", "lang": "en", "text": "Three. A relative needs a ṣila after it.", "pause": 0.3, "cues": ["li:3"]},
 {"id": "summary-16", "scene": "summary", "lang": "ar", "text": "صِلَةٌ", "pause": 0.4, "cues": ["ar:7"]},
 {"id": "summary-17", "scene": "summary", "lang": "en", "text": "The one who passed.", "pause": 0.3, "cues": []},
 {"id": "summary-18", "scene": "summary", "lang": "ar", "text": "الَّذِي نَجَحَ", "pause": 0.6, "cues": ["ar:8"]},
 {"id": "summary-19", "scene": "summary", "lang": "en", "text": "Four. Match the noun before it.", "pause": 0.3, "cues": ["li:4"]},
 {"id": "summary-20", "scene": "summary", "lang": "en", "text": "The relative copies the place of that noun: rafʿ, naṣb or jarr.", "pause": 0.6, "cues": []},
 {"id": "summary-21", "scene": "summary", "lang": "en", "text": "Five. These two are not fixed.", "pause": 0.3, "cues": ["li:5"]},
 {"id": "summary-22", "scene": "summary", "lang": "ar", "text": "اللَّذَانِ", "pause": 0.3, "cues": ["ar:9"]},
 {"id": "summary-23", "scene": "summary", "lang": "ar", "text": "اللَّتَانِ", "pause": 0.5, "cues": ["ar:10"]},
 {"id": "summary-24", "scene": "summary", "lang": "en", "text": "They are flexible. They wait for Stage 4.", "pause": 0.6, "cues": []},
 {"id": "summary-25", "scene": "summary", "lang": "en", "text": "Now open the Practice tab, and try the cards.", "pause": 1.0, "cues": ["practice"]}
