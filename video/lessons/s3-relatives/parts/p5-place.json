{"segments": [
 {"id": "c05-title-01", "scene": "c05-title", "lang": "en", "text": "Chapter five. Its place in the sentence.", "pause": 0.5, "cues": ["title"]},
 {"id": "c05-title-02", "scene": "c05-title", "lang": "en", "text": "A relative after a noun works like an adjective.", "pause": 0.3, "cues": ["sub"]},
 {"id": "c05-title-03", "scene": "c05-title", "lang": "en", "text": "An adjective copies the ending of its noun. But a relative is fixed. It cannot copy the ending.", "pause": 0.4, "cues": []},
 {"id": "c05-title-04", "scene": "c05-title", "lang": "en", "text": "So it copies the place of the noun before it: rafʿ, naṣb or jarr. Its ending does not change.", "pause": 0.7, "cues": []},
 {"id": "c05-ex-01", "scene": "c05-ex", "lang": "en", "text": "The student who passed came.", "pause": 0.4, "cues": ["ex:1"]},
 {"id": "c05-ex-02", "scene": "c05-ex", "lang": "ar", "text": "جَاءَ الطَّالِبُ الَّذِي نَجَحَ", "pause": 0.6, "cues": ["ar:0"]},
 {"id": "c05-ex-03", "scene": "c05-ex", "lang": "en", "text": "The student is the doer. It is rafʿ, with damma.", "pause": 0.4, "cues": ["note:1"]},
 {"id": "c05-ex-04", "scene": "c05-ex", "lang": "ar", "text": "الطَّالِبُ", "pause": 0.5, "cues": ["ar:1"]},
 {"id": "c05-ex-05", "scene": "c05-ex", "lang": "en", "text": "So the relative is in the place of rafʿ.", "pause": 0.4, "cues": ["hl:in the place of rafʿ"]},
 {"id": "c05-ex-06", "scene": "c05-ex", "lang": "ar", "text": "الَّذِي", "pause": 0.7, "cues": ["ar:2"]},
 {"id": "c05-ex-07", "scene": "c05-ex", "lang": "en", "text": "The principal thanked the student who passed.", "pause": 0.4, "cues": ["ex:2"]},
 {"id": "c05-ex-08", "scene": "c05-ex", "lang": "ar", "text": "شَكَرَ الْمُدِيرُ الطَّالِبَ الَّذِي نَجَحَ", "pause": 0.6, "cues": ["ar:3"]},
 {"id": "c05-ex-09", "scene": "c05-ex", "lang": "en", "text": "Now the student is the object. It is naṣb, with fatha.", "pause": 0.4, "cues": ["note:2"]},
 {"id": "c05-ex-10", "scene": "c05-ex", "lang": "ar", "text": "الطَّالِبَ", "pause": 0.5, "cues": ["ar:4"]},
 {"id": "c05-ex-11", "scene": "c05-ex", "lang": "en", "text": "So the relative is in the place of naṣb. Its ending stays the same.", "pause": 0.4, "cues": ["hl:in the place of naṣb"]},
 {"id": "c05-ex-12", "scene": "c05-ex", "lang": "ar", "text": "الَّذِي", "pause": 0.7, "cues": ["ar:5"]},
 {"id": "c05-ex-13", "scene": "c05-ex", "lang": "en", "text": "I went to the student who passed.", "pause": 0.4, "cues": ["ex:3"]},
 {"id": "c05-ex-14", "scene": "c05-ex", "lang": "ar", "text": "ذَهَبْتُ إِلَى الطَّالِبِ الَّذِي نَجَحَ", "pause": 0.6, "cues": ["ar:6"]},
 {"id": "c05-ex-15", "scene": "c05-ex", "lang": "en", "text": "Now the student comes after a preposition. It is jarr, with kasra.", "pause": 0.4, "cues": ["note:3"]},
 {"id": "c05-ex-16", "scene": "c05-ex", "lang": "ar", "text": "الطَّالِبِ", "pause": 0.5, "cues": ["ar:7"]},
 {"id": "c05-ex-17", "scene": "c05-ex", "lang": "en", "text": "So the relative is in the place of jarr. Again, its ending stays the same.", "pause": 0.4, "cues": ["hl:in the place of jarr"]},
 {"id": "c05-ex-18", "scene": "c05-ex", "lang": "ar", "text": "الَّذِي", "pause": 0.8, "cues": ["ar:8"]},
 {"id": "c05-tip-01", "scene": "c05-tip", "lang": "en", "text": "A tip. The two general relatives stand alone.", "pause": 0.4, "cues": ["show"]},
 {"id": "c05-tip-02", "scene": "c05-tip", "lang": "ar", "text": "مَنْ", "pause": 0.35, "cues": ["ar:0"]},
 {"id": "c05-tip-03", "scene": "c05-tip", "lang": "ar", "text": "مَا", "pause": 0.5, "cues": ["ar:1"]},
 {"id": "c05-tip-04", "scene": "c05-tip", "lang": "en", "text": "Stand alone means only that no noun comes before them. A ṣila still comes after them.", "pause": 0.3, "cues": []},
 {"id": "c05-tip-05", "scene": "c05-tip", "lang": "en", "text": "With no noun to copy, they have their own job.", "pause": 0.4, "cues": ["hl:they have their own job"]},
 {"id": "c05-tip-06", "scene": "c05-tip", "lang": "en", "text": "The one who passed came.", "pause": 0.4, "cues": []},
 {"id": "c05-tip-07", "scene": "c05-tip", "lang": "ar", "text": "جَاءَ مَنْ نَجَحَ", "pause": 0.6, "cues": ["ar:2"]},
 {"id": "c05-tip-08", "scene": "c05-tip", "lang": "en", "text": "Who came?", "pause": 0.5, "cues": []},
 {"id": "c05-tip-09", "scene": "c05-tip", "lang": "en", "text": "The one who passed. So this word is the doer.", "pause": 0.4, "cues": []},
 {"id": "c05-tip-10", "scene": "c05-tip", "lang": "ar", "text": "مَنْ", "pause": 0.5, "cues": ["ar:3"]},
 {"id": "c05-tip-11", "scene": "c05-tip", "lang": "en", "text": "The doer takes rafʿ. This word is fixed, so it is in the place of rafʿ.", "pause": 0.8, "cues": []}
]}
