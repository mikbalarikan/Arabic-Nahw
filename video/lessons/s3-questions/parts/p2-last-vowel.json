   ]
  },
  {
   "id": "c01-rule-07",
   "scene": "c01-rule",
   "lang": "ar",
   "text": "كَيْفَ",
   "pause": 0.4,
   "cues": [
    "hl:كَيْفَ"
   ]
  },
  {
   "id": "c01-rule-08",
   "scene": "c01-rule",
   "lang": "en",
   "text": "These four end in a long ā.",
   "pause": 0.3,
   "cues": [
    "hl:end in a long ā"
   ]
  },
  {
   "id": "c01-rule-09",
   "scene": "c01-rule",
   "lang": "ar",
   "text": "مَا",
   "pause": 0.25,
   "cues": [
