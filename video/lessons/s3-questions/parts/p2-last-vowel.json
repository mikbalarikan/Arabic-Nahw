   ]
  },
  {
   "id": "c01-rule-02",
   "scene": "c01-rule",
   "lang": "en",
   "text": "These two end in sukūn.",
   "pause": 0.3,
   "cues": [
    "hl:end in sukūn"
   ]
  },
  {
   "id": "c01-rule-03",
   "scene": "c01-rule",
   "lang": "ar",
   "text": "مَنْ",
   "pause": 0.25,
   "cues": [
