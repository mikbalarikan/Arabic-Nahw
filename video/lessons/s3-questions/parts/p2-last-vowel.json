   ]
  },
  {
   "id": "c01-rule-10",
   "scene": "c01-rule",
   "lang": "ar",
   "text": "مَاذَا",
   "pause": 0.25,
   "cues": [
    "hl:مَاذَا"
   ]
  },
  {
   "id": "c01-rule-11",
   "scene": "c01-rule",
   "lang": "ar",
   "text": "مَتَى",
   "pause": 0.25,
   "cues": [
    "hl:مَتَى"
   ]
  },
  {
