   ]
  },
  {
   "id": "c01-rule-04",
   "scene": "c01-rule",
   "lang": "ar",
   "text": "كَمْ",
   "pause": 0.4,
   "cues": [
    "hl:كَمْ"
   ]
  },
  {
   "id": "c01-rule-05",
   "scene": "c01-rule",
   "lang": "en",
   "text": "These two end in fatha.",
   "pause": 0.3,
   "cues": [
    "hl:end in fatha"
   ]
  },
  {
   "id": "c01-rule-06",
   "scene": "c01-rule",
   "lang": "ar",
   "text": "أَيْنَ",
