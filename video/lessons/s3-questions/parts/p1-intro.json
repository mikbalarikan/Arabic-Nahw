  },
  {
   "id": "c01-table-13",
   "scene": "c01-table",
   "lang": "en",
   "text": "What is this?",
   "pause": 0.3,
   "cues": []
  },
  {
   "id": "c01-table-14",
   "scene": "c01-table",
   "lang": "ar",
   "text": "هَذَا كِتَابٌ",
