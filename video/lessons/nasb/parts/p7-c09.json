   ]
  },
  {
   "id": "c09-rule-02",
   "scene": "c09-rule",
   "lang": "en",
   "text": "To find it, ask how.",
   "pause": 0.4,
   "cues": [
    "hl:how?"
   ]
  },
  {
   "id": "c09-rule-03",
   "scene": "c09-rule",
   "lang": "en",
   "text": "It has no al, so it almost always takes tanween.",
   "pause": 0.25,
   "cues": [
    "hl:no ال"
   ]
  },
  {
   "id": "c09-rule-04",
   "scene": "c09-rule",
   "lang": "en",
   "text": "The state takes naṣb, so it ends in fatha.",
   "pause": 0.5,
   "cues": [
    "hl:State → naṣb, fatha"
   ]
  },
  {
   "id": "c09-ex13-01",
   "scene": "c09-ex13",
   "lang": "en",
