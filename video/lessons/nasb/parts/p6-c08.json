   ]
  },
  {
   "id": "c08-title-02",
   "scene": "c08-title",
   "lang": "ar",
   "text": "مَفْعُولٌ فِيهِ",
   "pause": 0.6,
   "cues": []
  },
  {
   "id": "c08-rule-01",
   "scene": "c08-rule",
   "lang": "en",
   "text": "A time or place word tells us when or where the action happened.",
   "pause": 0.25,
   "cues": [
    "show",
    "hl:when or where the action happened"
   ]
  },
  {
   "id": "c08-rule-02",
   "scene": "c08-rule",
   "lang": "en",
   "text": "It has no preposition.",
   "pause": 0.25,
   "cues": [
    "hl:with no preposition"
   ]
  },
  {
   "id": "c08-rule-03",
   "scene": "c08-rule",
   "lang": "en",
   "text": "Ask when, or where.",
   "pause": 0.3,
   "cues": [
    "hl:Ask “when?” or “where?”"
   ]
  },
  {
   "id": "c08-rule-04",
   "scene": "c08-rule",
   "lang": "en",
   "text": "Time or place takes naṣb, so it ends in fatha.",
   "pause": 0.5,
   "cues": [
    "hl:Time/place → naṣb, fatha"
   ]
  },
  {
   "id": "c08-ex8-01",
   "scene": "c08-ex8",
   "lang": "en",
