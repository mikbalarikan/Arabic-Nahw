{"segments": [
 {"id": "c02-title-01", "scene": "c02-title", "lang": "en", "text": "Chapter two. The past verb. Fourteen persons.", "pause": 0.4, "cues": ["title"]},
 {"id": "c02-title-02", "scene": "c02-title", "lang": "en", "text": "Learn this table by heart.", "pause": 0.25, "cues": ["sub"]},
 {"id": "c02-title-03", "scene": "c02-title", "lang": "en", "text": "Each pronoun from unit one has its own past form.", "pause": 0.5, "cues": []},
 {"id": "c02-table-01", "scene": "c02-table", "lang": "en", "text": "Start with he, they two, and they. These are for men.", "pause": 0.4, "cues": []},
 {"id": "c02-table-02", "scene": "c02-table", "lang": "ar", "text": "كَتَبَ", "pause": 0.4, "cues": ["row:0"]},
 {"id": "c02-table-03", "scene": "c02-table", "lang": "ar", "text": "كَتَبَا", "pause": 0.4, "cues": ["row:1"]},
 {"id": "c02-table-04", "scene": "c02-table", "lang": "ar", "text": "كَتَبُوا", "pause": 0.5, "cues": ["row:2"]},
 {"id": "c02-table-05", "scene": "c02-table", "lang": "en", "text": "Now she, they two, and they, for women.", "pause": 0.4, "cues": []},
 {"id": "c02-table-06", "scene": "c02-table", "lang": "ar", "text": "كَتَبَتْ", "pause": 0.4, "cues": ["row:3"]},
 {"id": "c02-table-07", "scene": "c02-table", "lang": "ar", "text": "كَتَبَتَا", "pause": 0.4, "cues": ["row:4"]},
 {"id": "c02-table-08", "scene": "c02-table", "lang": "ar", "text": "كَتَبْنَ", "pause": 0.5, "cues": ["row:5"]},
 {"id": "c02-table-09", "scene": "c02-table", "lang": "en", "text": "Now you. One man, two men, and many men.", "pause": 0.4, "cues": []},
 {"id": "c02-table-10", "scene": "c02-table", "lang": "ar", "text": "كَتَبْتَ", "pause": 0.4, "cues": ["row:6"]},
 {"id": "c02-table-11", "scene": "c02-table", "lang": "ar", "text": "كَتَبْتُمَا", "pause": 0.4, "cues": ["row:7"]},
 {"id": "c02-table-12", "scene": "c02-table", "lang": "ar", "text": "كَتَبْتُمْ", "pause": 0.5, "cues": ["row:8"]},
 {"id": "c02-table-13", "scene": "c02-table", "lang": "en", "text": "You again. One woman, two women, and many women.", "pause": 0.4, "cues": []},
 {"id": "c02-table-14", "scene": "c02-table", "lang": "ar", "text": "كَتَبْتِ", "pause": 0.4, "cues": ["row:9"]},
 {"id": "c02-table-15", "scene": "c02-table", "lang": "ar", "text": "كَتَبْتُمَا", "pause": 0.4, "cues": ["row:10"]},
 {"id": "c02-table-16", "scene": "c02-table", "lang": "ar", "text": "كَتَبْتُنَّ", "pause": 0.5, "cues": ["row:11"]},
 {"id": "c02-table-17", "scene": "c02-table", "lang": "en", "text": "Last, I and we.", "pause": 0.4, "cues": []},
 {"id": "c02-table-18", "scene": "c02-table", "lang": "ar", "text": "كَتَبْتُ", "pause": 0.4, "cues": ["row:12"]},
 {"id": "c02-table-19", "scene": "c02-table", "lang": "ar", "text": "كَتَبْنَا", "pause": 0.5, "cues": ["row:13"]},
 {"id": "c02-table-20", "scene": "c02-table", "lang": "en", "text": "That is the whole table.", "pause": 0.6, "cues": ["unhl"]},
 {"id": "c02-tip-01", "scene": "c02-tip", "lang": "en", "text": "There are fourteen persons, but only thirteen written forms.", "pause": 0.25, "cues": ["show"]},
 {"id": "c02-tip-02", "scene": "c02-tip", "lang": "ar", "text": "كَتَبْتُمَا", "pause": 0.45, "cues": ["hl:is used for two men and for two women"]},
 {"id": "c02-tip-03", "scene": "c02-tip", "lang": "en", "text": "You two wrote. It is used for two men and for two women.", "pause": 0.6, "cues": []},
 {"id": "c02-examples-01", "scene": "c02-examples", "lang": "en", "text": "Three examples.", "pause": 0.3, "cues": []},
 {"id": "c02-examples-02", "scene": "c02-examples", "lang": "en", "text": "I went to the mosque.", "pause": 0.4, "cues": ["ex:0"]},
 {"id": "c02-examples-03", "scene": "c02-examples", "lang": "ar", "text": "أَنَا ذَهَبْتُ إِلَى المَسْجِدِ", "pause": 0.5, "cues": ["read:0"]},
 {"id": "c02-examples-04", "scene": "c02-examples", "lang": "en", "text": "The verb has the ending for I.", "pause": 0.5, "cues": []},
 {"id": "c02-examples-05", "scene": "c02-examples", "lang": "en", "text": "She sat in the room.", "pause": 0.4, "cues": ["ex:1"]},
 {"id": "c02-examples-06", "scene": "c02-examples", "lang": "ar", "text": "هِيَ جَلَسَتْ فِي الغُرْفَةِ", "pause": 0.5, "cues": ["read:1"]},
 {"id": "c02-examples-07", "scene": "c02-examples", "lang": "en", "text": "The verb has the form for she.", "pause": 0.5, "cues": []},
 {"id": "c02-examples-08", "scene": "c02-examples", "lang": "en", "text": "We did not go out of the house.", "pause": 0.4, "cues": ["ex:2"]},
 {"id": "c02-examples-09", "scene": "c02-examples", "lang": "ar", "text": "نَحْنُ مَا خَرَجْنَا مِنَ البَيْتِ", "pause": 0.5, "cues": ["read:2"]},
 {"id": "c02-examples-10", "scene": "c02-examples", "lang": "en", "text": "Look at the small word before the verb.", "pause": 0.4, "cues": ["note:2"]},
 {"id": "c02-examples-11", "scene": "c02-examples", "lang": "ar", "text": "مَا", "pause": 0.45, "cues": ["hl:مَا"]},
 {"id": "c02-examples-12", "scene": "c02-examples", "lang": "en", "text": "Before a past verb, it means did not. We come back to it in chapter five.", "pause": 0.7, "cues": []}
]}
