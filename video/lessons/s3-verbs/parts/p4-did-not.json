{"segments": [
 {"id": "c05-title-01", "scene": "c05-title", "lang": "en", "text": "Chapter five. Saying did not.", "pause": 0.4, "cues": ["title"]},
 {"id": "c05-title-02", "scene": "c05-title", "lang": "en", "text": "To say did not, put this word right before the past verb.", "pause": 0.4, "cues": ["sub"]},
 {"id": "c05-title-03", "scene": "c05-title", "lang": "ar", "text": "مَا", "pause": 0.45, "cues": []},
 {"id": "c05-title-04", "scene": "c05-title", "lang": "en", "text": "The verb does not change at all. Same form, same doer.", "pause": 0.6, "cues": []},
 {"id": "c05-table-01", "scene": "c05-table", "lang": "en", "text": "He did not write.", "pause": 0.3, "cues": ["row:0"]},
 {"id": "c05-table-02", "scene": "c05-table", "lang": "ar", "text": "مَا كَتَبَ", "pause": 0.45, "cues": []},
 {"id": "c05-table-03", "scene": "c05-table", "lang": "en", "text": "She did not write.", "pause": 0.3, "cues": ["row:1"]},
 {"id": "c05-table-04", "scene": "c05-table", "lang": "ar", "text": "مَا كَتَبَتْ", "pause": 0.45, "cues": []},
 {"id": "c05-table-05", "scene": "c05-table", "lang": "en", "text": "I did not go.", "pause": 0.3, "cues": ["row:2"]},
 {"id": "c05-table-06", "scene": "c05-table", "lang": "ar", "text": "مَا ذَهَبْتُ", "pause": 0.45, "cues": []},
 {"id": "c05-table-07", "scene": "c05-table", "lang": "en", "text": "They did not go out.", "pause": 0.3, "cues": ["row:3"]},
 {"id": "c05-table-08", "scene": "c05-table", "lang": "ar", "text": "مَا خَرَجُوا", "pause": 0.6, "cues": []},
 {"id": "c05-rule-01", "scene": "c05-rule", "lang": "en", "text": "This word means not. It is a ḥarf.", "pause": 0.25, "cues": ["show", "hl:is a ḥarf of negation"]},
 {"id": "c05-rule-02", "scene": "c05-rule", "lang": "en", "text": "It is fixed, with no place.", "pause": 0.4, "cues": ["hl:It is a ḥarf: fixed, with no place"]},
 {"id": "c05-rule-03", "scene": "c05-rule", "lang": "ar", "text": "لَا مَحَلَّ لَهُ مِنَ الإِعْرَابِ", "pause": 0.5, "cues": []},
 {"id": "c05-rule-04", "scene": "c05-rule", "lang": "en", "text": "It does not change the verb after it.", "pause": 0.7, "cues": ["hl:It does not change the verb after it"]},
 {"id": "c05-examples-01", "scene": "c05-examples", "lang": "en", "text": "I did not go to the market.", "pause": 0.4, "cues": ["ex:0"]},
 {"id": "c05-examples-02", "scene": "c05-examples", "lang": "ar", "text": "مَا ذَهَبْتُ إِلَى السُّوقِ", "pause": 0.5, "cues": ["read:0"]},
 {"id": "c05-examples-03", "scene": "c05-examples", "lang": "en", "text": "The ending for I is still the doer, in the place of rafʿ.", "pause": 0.5, "cues": ["note:0"]},
 {"id": "c05-examples-04", "scene": "c05-examples", "lang": "en", "text": "The student did not go out of the classroom.", "pause": 0.4, "cues": ["ex:1"]},
 {"id": "c05-examples-05", "scene": "c05-examples", "lang": "ar", "text": "مَا خَرَجَ الطَّالِبُ مِنَ الفَصْلِ", "pause": 0.6, "cues": ["read:1"]},
 {"id": "c05-examples-06", "scene": "c05-examples", "lang": "en", "text": "We did not open the door.", "pause": 0.4, "cues": ["ex:2"]},
 {"id": "c05-examples-07", "scene": "c05-examples", "lang": "ar", "text": "مَا فَتَحْنَا البَابَ", "pause": 0.6, "cues": ["read:2"]},
 {"id": "c05-examples-08", "scene": "c05-examples", "lang": "en", "text": "Did you write the lesson? No, I did not write it.", "pause": 0.4, "cues": ["ex:3"]},
 {"id": "c05-examples-09", "scene": "c05-examples", "lang": "ar", "text": "هَلْ كَتَبْتَ الدَّرْسَ؟ لَا، مَا كَتَبْتُهُ", "pause": 0.5, "cues": ["read:3"]},
 {"id": "c05-examples-10", "scene": "c05-examples", "lang": "en", "text": "In the answer, the first small word means no.", "pause": 0.3, "cues": ["note:3"]},
 {"id": "c05-examples-11", "scene": "c05-examples", "lang": "ar", "text": "لَا", "pause": 0.4, "cues": []},
 {"id": "c05-examples-12", "scene": "c05-examples", "lang": "en", "text": "The second one makes the verb did not.", "pause": 0.3, "cues": []},
 {"id": "c05-examples-13", "scene": "c05-examples", "lang": "ar", "text": "مَا", "pause": 0.7, "cues": []},
 {"id": "c05-tips-01", "scene": "c05-tips", "lang": "en", "text": "Do not mix up two words that look the same.", "pause": 0.25, "cues": ["tip:0"]},
 {"id": "c05-tips-02", "scene": "c05-tips", "lang": "en", "text": "The word for did not is a ḥarf, with no place.", "pause": 0.25, "cues": []},
 {"id": "c05-tips-03", "scene": "c05-tips", "lang": "en", "text": "The one in unit five means what. It is an ism, and it has a place.", "pause": 0.4, "cues": []},
 {"id": "c05-tips-04", "scene": "c05-tips", "lang": "ar", "text": "مَا هَذَا؟", "pause": 0.45, "cues": []},
 {"id": "c05-tips-05", "scene": "c05-tips", "lang": "en", "text": "What is this?", "pause": 0.6, "cues": []},
 {"id": "c05-tips-06", "scene": "c05-tips", "lang": "en", "text": "You already know the word for no.", "pause": 0.4, "cues": ["tip:1"]},
 {"id": "c05-tips-07", "scene": "c05-tips", "lang": "ar", "text": "لَا", "pause": 0.45, "cues": []},
 {"id": "c05-tips-08", "scene": "c05-tips", "lang": "en", "text": "With the present verb, it also means do not. That comes later in the course.", "pause": 0.25, "cues": []},
 {"id": "c05-tips-09", "scene": "c05-tips", "lang": "en", "text": "With the past verb, we use the other word.", "pause": 0.4, "cues": []},
 {"id": "c05-tips-10", "scene": "c05-tips", "lang": "ar", "text": "مَا", "pause": 0.7, "cues": []}
]}
