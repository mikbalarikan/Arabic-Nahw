{"segments": [
 {"id": "c03-title-01", "scene": "c03-title", "lang": "en", "text": "Chapter three. The ending is the doer.", "pause": 0.4, "cues": ["title"]},
 {"id": "c03-title-02", "scene": "c03-title", "lang": "en", "text": "Most endings of the past verb are attached pronouns.", "pause": 0.25, "cues": ["sub"]},
 {"id": "c03-title-03", "scene": "c03-title", "lang": "en", "text": "The pronoun is the doer. It is fixed, in the place of rafʿ.", "pause": 0.4, "cues": []},
 {"id": "c03-title-04", "scene": "c03-title", "lang": "ar", "text": "فِي مَحَلِّ رَفْعٍ", "pause": 0.6, "cues": []},
 {"id": "c03-words-01", "scene": "c03-words", "lang": "en", "text": "Here are the doer endings.", "pause": 0.3, "cues": []},
 {"id": "c03-words-02", "scene": "c03-words", "lang": "en", "text": "This ending means I.", "pause": 0.3, "cues": ["item:0"]},
 {"id": "c03-words-03", "scene": "c03-words", "lang": "en", "text": "You, for one man.", "pause": 0.3, "cues": ["item:1"]},
 {"id": "c03-words-04", "scene": "c03-words", "lang": "en", "text": "You, for one woman.", "pause": 0.3, "cues": ["item:2"]},
 {"id": "c03-words-05", "scene": "c03-words", "lang": "en", "text": "And we.", "pause": 0.3, "cues": ["item:3"]},
 {"id": "c03-words-06", "scene": "c03-words", "lang": "en", "text": "You all, for men.", "pause": 0.3, "cues": ["item:4"]},
 {"id": "c03-words-07", "scene": "c03-words", "lang": "en", "text": "They, for men.", "pause": 0.3, "cues": ["item:5"]},
 {"id": "c03-words-08", "scene": "c03-words", "lang": "en", "text": "They, for women.", "pause": 0.3, "cues": ["item:6"]},
 {"id": "c03-words-09", "scene": "c03-words", "lang": "en", "text": "And they two.", "pause": 0.4, "cues": ["item:7"]},
 {"id": "c03-words-10", "scene": "c03-words", "lang": "en", "text": "Each of these endings is the doer.", "pause": 0.6, "cues": []},
 {"id": "c03-rule-01", "scene": "c03-rule", "lang": "en", "text": "But one ending is different.", "pause": 0.4, "cues": ["show"]},
 {"id": "c03-rule-02", "scene": "c03-rule", "lang": "ar", "text": "كَتَبَتْ", "pause": 0.45, "cues": []},
 {"id": "c03-rule-03", "scene": "c03-rule", "lang": "en", "text": "She wrote. Here the ending only shows that the doer is feminine.", "pause": 0.25, "cues": ["hl:only shows that the doer is feminine"]},
 {"id": "c03-rule-04", "scene": "c03-rule", "lang": "en", "text": "It is a ḥarf, with no place.", "pause": 0.25, "cues": ["hl:It is a ḥarf, with no place"]},
 {"id": "c03-rule-05", "scene": "c03-rule", "lang": "en", "text": "The doer is hidden. It is she.", "pause": 0.4, "cues": ["hl:The doer is hidden"]},
 {"id": "c03-rule-06", "scene": "c03-rule", "lang": "ar", "text": "هِيَ", "pause": 0.6, "cues": []},
 {"id": "c03-cols-01", "scene": "c03-cols", "lang": "en", "text": "So compare three forms.", "pause": 0.3, "cues": []},
 {"id": "c03-cols-02", "scene": "c03-cols", "lang": "en", "text": "First, a hidden doer.", "pause": 0.3, "cues": ["item:0"]},
 {"id": "c03-cols-03", "scene": "c03-cols", "lang": "ar", "text": "كَتَبَ", "pause": 0.45, "cues": []},
 {"id": "c03-cols-04", "scene": "c03-cols", "lang": "en", "text": "There is no ending. The doer is hidden. It is he.", "pause": 0.5, "cues": []},
 {"id": "c03-cols-05", "scene": "c03-cols", "lang": "en", "text": "Second, a hidden doer again.", "pause": 0.3, "cues": ["item:1"]},
 {"id": "c03-cols-06", "scene": "c03-cols", "lang": "ar", "text": "كَتَبَتْ", "pause": 0.45, "cues": []},
 {"id": "c03-cols-07", "scene": "c03-cols", "lang": "en", "text": "This ending is a ḥarf. The doer is hidden. It is she.", "pause": 0.5, "cues": []},
 {"id": "c03-cols-08", "scene": "c03-cols", "lang": "en", "text": "Third, an attached doer.", "pause": 0.3, "cues": ["item:2"]},
 {"id": "c03-cols-09", "scene": "c03-cols", "lang": "ar", "text": "كَتَبْتُ", "pause": 0.45, "cues": []},
 {"id": "c03-cols-10", "scene": "c03-cols", "lang": "en", "text": "The ending is the doer, in the place of rafʿ.", "pause": 0.6, "cues": []},
 {"id": "c03-tip-01", "scene": "c03-tip", "lang": "en", "text": "When a noun is the doer, the verb has no doer ending.", "pause": 0.4, "cues": ["show"]},
 {"id": "c03-tip-02", "scene": "c03-tip", "lang": "ar", "text": "كَتَبَ الطَّالِبُ", "pause": 0.5, "cues": []},
 {"id": "c03-tip-03", "scene": "c03-tip", "lang": "en", "text": "The student wrote. The student is the doer.", "pause": 0.7, "cues": []},
 {"id": "c04-title-01", "scene": "c04-title", "lang": "en", "text": "Chapter four. What the past verb is built on.", "pause": 0.4, "cues": ["title"]},
 {"id": "c04-title-02", "scene": "c04-title", "lang": "en", "text": "A fixed word is built on one fixed mark. A past verb is built on fatha, damma or sukūn.", "pause": 0.25, "cues": ["sub"]},
 {"id": "c04-title-03", "scene": "c04-title", "lang": "en", "text": "Look at the last letter of the verb itself, before any doer pronoun.", "pause": 0.5, "cues": []},
 {"id": "c04-table-01", "scene": "c04-table", "lang": "en", "text": "The past verb is built on fatha when it has no ending.", "pause": 0.25, "cues": ["row:0"]},
 {"id": "c04-table-02", "scene": "c04-table", "lang": "en", "text": "It is also built on fatha before the ḥarf for she, and before the alif for they two.", "pause": 0.4, "cues": []},
 {"id": "c04-table-03", "scene": "c04-table", "lang": "ar", "text": "كَتَبَ", "pause": 0.35, "cues": ["cell:0:2"]},
 {"id": "c04-table-04", "scene": "c04-table", "lang": "ar", "text": "كَتَبَتْ", "pause": 0.35, "cues": []},
 {"id": "c04-table-05", "scene": "c04-table", "lang": "ar", "text": "كَتَبَا", "pause": 0.35, "cues": []},
 {"id": "c04-table-06", "scene": "c04-table", "lang": "ar", "text": "كَتَبَتَا", "pause": 0.5, "cues": []},
 {"id": "c04-table-07", "scene": "c04-table", "lang": "en", "text": "It is built on damma before the ending for they, for men.", "pause": 0.4, "cues": ["row:1"]},
 {"id": "c04-table-08", "scene": "c04-table", "lang": "ar", "text": "كَتَبُوا", "pause": 0.5, "cues": []},
 {"id": "c04-table-09", "scene": "c04-table", "lang": "en", "text": "It is built on sukūn before all the other endings.", "pause": 0.4, "cues": ["row:2"]},
 {"id": "c04-table-10", "scene": "c04-table", "lang": "ar", "text": "كَتَبْتُ", "pause": 0.35, "cues": ["cell:2:2"]},
 {"id": "c04-table-11", "scene": "c04-table", "lang": "ar", "text": "كَتَبْنَا", "pause": 0.35, "cues": []},
 {"id": "c04-table-12", "scene": "c04-table", "lang": "ar", "text": "كَتَبْنَ", "pause": 0.5, "cues": []},
 {"id": "c04-table-13", "scene": "c04-table", "lang": "en", "text": "Before these endings, the last letter of the verb has sukūn.", "pause": 0.6, "cues": []},
 {"id": "c04-rule-01", "scene": "c04-rule", "lang": "en", "text": "One more look at she wrote.", "pause": 0.4, "cues": ["show"]},
 {"id": "c04-rule-02", "scene": "c04-rule", "lang": "ar", "text": "كَتَبَتْ", "pause": 0.45, "cues": []},
 {"id": "c04-rule-03", "scene": "c04-rule", "lang": "en", "text": "It is built on fatha. The fatha is on the letter before the ending.", "pause": 0.25, "cues": ["hl:The fatha is on the ب"]},
 {"id": "c04-rule-04", "scene": "c04-rule", "lang": "en", "text": "The sukūn sits on the ḥarf after it.", "pause": 0.25, "cues": ["hl:The sukūn sits on the ḥarf"]},
 {"id": "c04-rule-05", "scene": "c04-rule", "lang": "en", "text": "That sukūn belongs to the ḥarf. The verb itself is built on fatha.", "pause": 0.7, "cues": []}
]}
